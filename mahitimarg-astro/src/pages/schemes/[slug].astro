---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

// 1. Generate a new path for every collection entry
export async function getStaticPaths() {
  const schemeEntries = await getCollection('schemes');
  return schemeEntries.map(entry => ({
    params: { slug: entry.id }, props: { entry },
  }));
}

// 2. For your template, you can get the entry directly from the prop
const { entry } = Astro.props;
const { Content } = await render(entry);

// Dynamic SEO properties based on frontmatter
const seoTitle = `${entry.data.title} | MahitiMarg 2026`;

// Determine icon based on badge
let iconClass = 'fa-file-lines';
const cat = entry.data.badge.toLowerCase();
if (cat.includes('farmer') || cat.includes('शेतकरी')) {
  iconClass = 'fa-tractor';
} else if (cat.includes('women') || cat.includes('महिला')) {
  iconClass = 'fa-person-dress';
} else if (cat.includes('business') || cat.includes('व्यवसाय') || cat.includes('employment')) {
  iconClass = 'fa-store';
} else if (cat.includes('student') || cat.includes('विद्यार्थी')) {
  iconClass = 'fa-graduation-cap';
}

// WhatsApp share URL
const pageUrl = `https://mahitimarg.in/schemes/${entry.id}`;
const whatsappText = encodeURIComponent(`${entry.data.title}\n\n${entry.data.description}\n\nसंपूर्ण माहिती वाचा:\n${pageUrl}`);
const whatsappUrl = `https://api.whatsapp.com/send?text=${whatsappText}`;

// Fetch other schemes for sidebar
const allSchemes = await getCollection('schemes');
const otherSchemes = allSchemes.filter(s => s.id !== entry.id).slice(0, 4);
---

<Layout title={seoTitle} description={entry.data.description}>
    <!-- Premium Header Banner -->
    <section class="scheme-detail-banner">
        <div class="container">
            <!-- Breadcrumbs -->
            <nav class="scheme-breadcrumbs" aria-label="Breadcrumb">
                <a href="/"><i class="fa-solid fa-house"></i> होम</a>
                <span class="separator"><i class="fa-solid fa-chevron-right"></i></span>
                <a href="/#popular-schemes">योजना</a>
                <span class="separator"><i class="fa-solid fa-chevron-right"></i></span>
                <span>{entry.data.title}</span>
            </nav>

            <!-- Icon + Badges -->
            <div class="scheme-banner-meta">
                <div class="scheme-banner-icon">
                    <i class={`fa-solid ${iconClass}`}></i>
                </div>
                <div class="scheme-banner-badges">
                    <span class="badge">{entry.data.badge}</span>
                    <span class="badge badge-active">Active</span>
                </div>
            </div>

            <!-- Title and Description -->
            <h1>{entry.data.title}</h1>
            <p>{entry.data.description}</p>
        </div>
    </section>

    <!-- Detail Grid: Content + Sidebar -->
    <div class="scheme-detail-grid">

        <!-- Main Content -->
        <article class="glass-panel" style="padding: 2.5rem; background: #fff;">
            <div class="markdown-content">
              <Content />
            </div>

            {entry.data.apply_link && entry.data.apply_link !== '#' && (
              <div style="margin-top: 3rem; text-align: center; padding-top: 2rem; border-top: 1px solid rgba(0,0,0,0.08);">
                  <h2 style="color: var(--text-dark); margin-bottom: 1rem;"><i class="fa-solid fa-laptop-file" style="color: var(--primary);"></i> ऑनलाइन अर्ज करा</h2>
                  <a href={entry.data.apply_link} class="btn btn-primary" target="_blank" rel="noopener noreferrer" style="font-size: 1.1rem; padding: 1rem 2.5rem;">
                    <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i> Apply Now / अर्ज करा
                  </a>
              </div>
            )}
        </article>

        <!-- Sidebar -->
        <aside class="scheme-quick-info">

            <!-- Quick Info Card -->
            <div class="quick-info-card">
                <h3><i class="fa-solid fa-circle-info" style="color: var(--primary);"></i> द्रुत माहिती</h3>

                {entry.data.key_stat && (
                    <div class="quick-info-stat">
                        <i class="fa-solid fa-chart-line"></i>
                        <span>{entry.data.key_stat}</span>
                    </div>
                )}

                {entry.data.apply_link && entry.data.apply_link !== '#' && (
                    <a href={entry.data.apply_link} class="btn btn-primary btn-block" target="_blank" rel="noopener noreferrer" style="margin-bottom: 0.75rem;">
                        <i class="fa-solid fa-arrow-up-right-from-square"></i> ऑनलाइन अर्ज करा
                    </a>
                )}

                <a href={whatsappUrl} class="whatsapp-share-btn" target="_blank" rel="noopener noreferrer">
                    <i class="fa-brands fa-whatsapp"></i> WhatsApp वर शेअर करा
                </a>
            </div>

            <!-- Table of Contents (populated by JS) -->
            <div class="scheme-toc" id="toc-container">
                <h3><i class="fa-solid fa-list"></i> अनुक्रमणिका (TOC)</h3>
                <ul id="toc-list">
                    <!-- Generated by JS -->
                </ul>
            </div>

            <!-- Other Popular Schemes -->
            <div class="quick-info-card">
                <h3><i class="fa-solid fa-fire" style="color: var(--accent);"></i> इतर लोकप्रिय योजना</h3>
                <ul style="list-style: none; padding: 0; line-height: 2;">
                    {otherSchemes.map(s => (
                        <li>
                            <a href={`/schemes/${s.id}`} style="text-decoration: none; color: var(--primary); font-weight: 500; display: flex; align-items: center; gap: 0.4rem;">
                                <i class="fa-solid fa-angle-right" aria-hidden="true"></i> {s.data.title}
                            </a>
                        </li>
                    ))}
                </ul>
            </div>

        </aside>
    </div>

    <style is:global>
        /* Styles specific to rendered Markdown content inside Scheme Details */
        .markdown-content {
            overflow-wrap: anywhere;
            word-break: break-word;
        }
        .markdown-content h2 {
            color: var(--text-dark);
            margin-top: 2.5rem;
            margin-bottom: 1rem;
            font-size: 1.5rem;
            border-bottom: 1px solid rgba(0,0,0,0.05);
            padding-bottom: 0.5rem;
        }
        .markdown-content h3 {
            color: var(--primary);
            margin-top: 1.5rem;
            margin-bottom: 0.75rem;
            font-size: 1.25rem;
        }
        .markdown-content p {
            line-height: 1.8;
            margin-bottom: 1rem;
            color: var(--text-dark);
        }
        .markdown-content ul {
            line-height: 1.8;
            margin-bottom: 1.5rem;
            padding-left: 1.5rem;
            color: var(--text-dark);
        }
        .markdown-content ol {
            line-height: 1.8;
            margin-bottom: 1.5rem;
            padding-left: 1.5rem;
            color: var(--text-dark);
        }
        .markdown-content li {
            margin-bottom: 0.5rem;
        }
        .markdown-content strong {
            color: var(--primary-color);
        }
        .markdown-content table {
            width: 100%;
            border-collapse: collapse;
            margin: 1.5rem 0;
            font-size: 0.95rem;
            display: block;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }
        .markdown-content th, .markdown-content td {
            border: 1px solid rgba(0,0,0,0.1);
            padding: 0.75rem 1rem;
            text-align: left;
            min-width: 120px;
        }
        .markdown-content th {
            background: var(--primary);
            color: white;
            font-weight: 600;
        }
        .markdown-content tr:nth-child(even) {
            background: rgba(0,0,0,0.02);
        }
    </style>

    <!-- TOC Generation Script -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const content = document.querySelector('.markdown-content');
            const tocList = document.getElementById('toc-list');
            const tocContainer = document.getElementById('toc-container');
            if (!content || !tocList) return;

            const headings = content.querySelectorAll('h2');
            if (headings.length === 0) {
                // Hide TOC if no headings
                if (tocContainer) tocContainer.style.display = 'none';
                return;
            }

            headings.forEach((h, i) => {
                const id = 'section-' + i;
                h.id = id;
                const li = document.createElement('li');
                const a = document.createElement('a');
                a.href = '#' + id;
                a.textContent = h.textContent;
                li.appendChild(a);
                tocList.appendChild(li);
            });
        });
    </script>

</Layout>
