---
// SchemeCard.astro
interface Props {
  scheme: any;
}
const { scheme } = Astro.props;

// ── Determine category styling ──
let iconClass = 'fa-leaf';
let bgClass = 'bg-blue';
let badgeText = '📋 Scheme';

const cat = scheme.data.badge.toLowerCase();
if (cat.includes('farmer') || cat.includes('शेतकरी')) {
  iconClass = 'fa-tractor';
  bgClass = 'bg-green';
  badgeText = '🧑‍🌾 Farmer';
} else if (cat.includes('women') || cat.includes('महिला')) {
  iconClass = 'fa-person-dress';
  bgClass = 'bg-pink';
  badgeText = '👩 Women';
} else if (cat.includes('business') || cat.includes('व्यवसाय')) {
  iconClass = 'fa-store';
  bgClass = 'bg-orange';
  badgeText = '💼 Business';
} else if (cat.includes('student') || cat.includes('विद्यार्थी')) {
  iconClass = 'fa-graduation-cap';
  bgClass = 'bg-purple';
  badgeText = '🎓 Students';
}

// ── Build English keyword set for search ──
// Extract English words from the title (e.g. "PMMY", "AIF", "Kisan")
const titleEn = scheme.data.title
  .replace(/[()]/g, ' ')
  .split(/[\s\-–]+/)
  .filter((w: string) => /^[a-zA-Z]/.test(w))
  .join(' ')
  .toLowerCase();

// Map badge category to rich English keywords
const categoryKeywords: Record<string, string> = {
  farmer:    'farmer farming agriculture kisan agri crop fpo rural sheti',
  शेतकरी:   'farmer farming agriculture kisan agri crop fpo rural sheti',
  women:     'women mahila girls mother ladki bahin empowerment',
  महिला:     'women mahila girls mother ladki bahin empowerment',
  business:  'business loan mudra msme startup employment shop store udyam',
  व्यवसाय:  'business loan mudra msme startup employment shop store udyam',
  student:   'student scholarship education school college vidyarthi',
  विद्यार्थी: 'student scholarship education school college vidyarthi',
  agri:      'agri agriculture infrastructure farming fpo pacs aif cold storage warehouse',
  mudra:     'mudra loan business micro finance shishu kishore tarun pmmy',
};

let extraKeywords = titleEn;
for (const [key, words] of Object.entries(categoryKeywords)) {
  if (cat.includes(key)) extraKeywords += ' ' + words;
}
// Also include slug-style id for "aif scheme guide" style searches
const schemeId = scheme.id.toLowerCase().replace(/[_-]/g, ' ');
extraKeywords += ' ' + schemeId;
---

<article class="glass-panel scheme-card animate-on-scroll" data-tags={scheme.data.badge.toLowerCase()} data-keywords={extraKeywords}>
  <div class="scheme-img-wrapper">
    <div class={`scheme-icon-bg ${bgClass}`}>
      <i class={`fa-solid ${iconClass}`} aria-hidden="true"></i>
    </div>
    <div class="badge-group">
      <span class="badge badge-tag">{badgeText}</span>
      <span class="badge badge-active">Active</span>
    </div>
  </div>
  <div class="scheme-card-content">
    <h3>{scheme.data.title}</h3>
    <p class="scheme-desc">{scheme.data.description}</p>
    {scheme.data.key_stat && (
      <div class="scheme-key-stat">
        <i class="fa-solid fa-chart-line" aria-hidden="true"></i>
        {scheme.data.key_stat}
      </div>
    )}
  </div>
  <a href={`/schemes/${scheme.id}`} class="btn btn-primary btn-block btn-read-more ripple-effect">
    माहिती वाचा <i class="fa-solid fa-arrow-right arrow-icon"></i>
  </a>
</article>
