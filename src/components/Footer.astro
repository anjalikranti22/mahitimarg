---
// Footer.astro
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isEn = lang === 'en';

const links = {
    home: isEn ? '/en' : '/',
    schemes: isEn ? '/en/schemes' : '/schemes',
    articles: isEn ? '/en/articles' : '/articles',
    tools: isEn ? '/en/tools' : '/tools',
    jobs: isEn ? '/en/jobs' : '/jobs',
    about: isEn ? '/en/about' : '/about',
    privacy: isEn ? '/en/privacy' : '/privacy',
    contact: isEn ? '/en/contact' : '/contact',
};

const searchUrl = isEn ? '/en#scheme-search' : '/#scheme-search';
---
<nav class="mobile-bottom-nav hidden-desktop" aria-label="Mobile Navigation">
    <a href={links.home} class="nav-item active" aria-label="Home">
        <i class="fa-solid fa-house" aria-hidden="true"></i>
        <span>{t('nav.home')}</span>
    </a>
    <a href={links.schemes} class="nav-item" aria-label="Schemes">
        <i class="fa-solid fa-file-lines" aria-hidden="true"></i>
        <span>{t('nav.schemes')}</span>
    </a>
    <a href={links.tools} class="nav-item" aria-label="Tools">
        <i class="fa-solid fa-wrench" aria-hidden="true"></i>
        <span>{t('nav.tools')}</span>
    </a>
    <a href={links.jobs} class="nav-item" aria-label="Jobs">
        <i class="fa-solid fa-briefcase" aria-hidden="true"></i>
        <span>{t('nav.jobs')}</span>
    </a>
    <a href={searchUrl} class="nav-item" aria-label="Search">
        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
        <span>{t('nav.search')}</span>
    </a>
</nav>

<footer class="main-footer">
    <div class="container footer-grid">
        <div class="footer-brand">
            <div class="logo-icon footer-logo-bg" aria-hidden="true">
                <i class="fa-solid fa-seedling"></i>
            </div>
            <h2>MahitiMarg Portal</h2>
            <p>{t('footer.brandDesc')}</p>
        </div>

        <div class="footer-links-col">
            <h3>{t('footer.quickLinks')}</h3>
            <nav aria-label="Footer Navigation">
                <ul>
                    <li><a href={links.home}>{t('nav.home')}</a></li>
                    <li><a href={links.schemes}>{t('footer.allSchemes')}</a></li>
                    <li><a href={links.articles}>{t('nav.articles')}</a></li>
                    <li><a href={links.tools}>{t('nav.tools')}</a></li>
                    <li><a href={links.jobs}>{t('nav.jobs')}</a></li>
                    <li><a href={links.about}>{t('nav.about')}</a></li>
                    <li><a href={links.privacy}>{t('nav.privacy')}</a></li>
                    <li><a href={links.contact}>{t('nav.contact')}</a></li>
                </ul>
            </nav>
        </div>

        <div class="footer-contact-col">
            <h3>{t('footer.contactSupport')}</h3>
            <p><i class="fa-solid fa-envelope" aria-hidden="true"></i> <a href="mailto:contact@logicpathsystems.com" style="color:inherit;">contact@logicpathsystems.com</a></p>
            <p style="margin-top:0.5rem; font-size:0.85rem; opacity:0.8;"><i class="fa-solid fa-circle-info"></i> {t('footer.privateNote')}</p>
        </div>
    </div>

    <div class="footer-disclaimer">
        <div class="container">
            <i class="fa-solid fa-triangle-exclamation" aria-hidden="true" style="color: #fbbf24; margin-right: 0.5rem;"></i>
            <strong>{t('footer.disclaimerLabel')}</strong> {t('footer.disclaimerText')}
        </div>
    </div>

    <div class="footer-copyright">
        <div class="container">
            &copy; 2026 {t('footer.rights')}
        </div>
    </div>
</footer>

<!-- ✅ SiteNavigationElement Schema: helps Google understand site structure deeply -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "SiteLinksSearchBox",
  "url": "https://mahitimarg.in",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://mahitimarg.in/schemes?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "MahitiMarg Site Navigation",
  "itemListElement": [
    { "@type": "SiteLinksSearchBox", "position": 1,
      "item": { "@type": "WebPage", "url": "https://mahitimarg.in/", "name": "Home / मुख्यपृष्ठ" }
    },
    { "@type": "ListItem", "position": 2,
      "item": { "@type": "WebPage", "url": "https://mahitimarg.in/schemes", "name": "Government Schemes / सरकारी योजना" }
    },
    { "@type": "ListItem", "position": 3,
      "item": { "@type": "WebPage", "url": "https://mahitimarg.in/tools", "name": "Smart Tools / स्मार्ट टूल्स" }
    },
    { "@type": "ListItem", "position": 4,
      "item": { "@type": "WebPage", "url": "https://mahitimarg.in/jobs", "name": "Jobs / नोकरी" }
    },
    { "@type": "ListItem", "position": 5,
      "item": { "@type": "WebPage", "url": "https://mahitimarg.in/articles", "name": "Articles / लेख" }
    },
    { "@type": "ListItem", "position": 6,
      "item": { "@type": "WebPage", "url": "https://mahitimarg.in/categories", "name": "Categories / श्रेणी" }
    }
  ]
}
</script>
