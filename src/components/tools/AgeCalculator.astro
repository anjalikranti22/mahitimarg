---
---
<div class="relative w-full max-w-lg mx-auto">
  <!-- Decorative background elements -->
  <div class="absolute -top-10 -left-10 w-32 h-32 bg-indigo-400 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-blob"></div>
  <div class="absolute -top-10 -right-10 w-32 h-32 bg-teal-400 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-blob animation-delay-2000"></div>
  <div class="absolute -bottom-8 left-20 w-32 h-32 bg-blue-500 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-blob animation-delay-4000"></div>

  <div class="relative z-10 text-center mb-8">
    <h2 class="text-3xl md:text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-indigo-700 to-teal-700 mb-2 drop-shadow-sm">वय कॅल्क्युलेटर</h2>
    <p class="text-slate-600 font-medium max-w-md mx-auto">तुमची नेमकी जन्म तारीख टाकून तुमचे आजचे अचूक वय महिने आणि दिवसांसह काढा.</p>
  </div>

  <div class="relative z-10 bg-white/70 backdrop-blur-xl p-8 rounded-[2rem] border border-white/50 shadow-[0_20px_50px_-12px_rgba(0,0,0,0.1)] shadow-teal-500/5 mb-10 overflow-hidden">
    <!-- Inner subtle glow -->
    <div class="absolute inset-0 bg-gradient-to-br from-white/40 to-white/10 pointer-events-none"></div>

    <div class="relative space-y-6 z-20">
      <div class="relative group">
        <label for="dobInput" class="block text-sm font-bold text-slate-700 mb-2 ml-1">तुमची जन्मतारीख निवडा <span class="text-red-500">*</span></label>
        <div class="absolute inset-0 top-7 bg-gradient-to-r from-indigo-200 to-teal-200 rounded-2xl blur opacity-20 group-hover:opacity-40 transition duration-500"></div>
        <input 
          type="date" 
          id="dobInput" 
          class="relative w-full rounded-2xl border border-slate-200 bg-white/80 px-5 py-4 text-lg font-bold text-slate-800 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 focus:bg-white focus:outline-none transition-all shadow-sm shadow-slate-100" 
          required 
          max="" 
        />
      </div>

      <button type="button" id="calculateAgeBtn" class="group relative w-full block rounded-2xl bg-gradient-to-r from-indigo-600 to-teal-600 px-8 py-4 font-bold text-white shadow-xl shadow-teal-600/20 transition-all hover:-translate-y-1 hover:shadow-teal-500/40 active:translate-y-0 active:scale-95 focus:outline-none focus:ring-2 focus:ring-teal-500 focus:ring-offset-2 text-xl overflow-hidden mt-4">
        <div class="absolute inset-0 bg-white/20 translate-y-full group-hover:translate-y-0 transition-transform duration-300 ease-out"></div>
        <span class="relative z-10 flex items-center justify-center gap-3">
          <i class="fa-solid fa-cake-candles"></i> वय काढा
        </span>
      </button>
    </div>
    
    <div id="ageResultBox" class="hidden mt-8 transition-all duration-500 transform scale-95 opacity-0 text-center">
      <div class="bg-gradient-to-br from-indigo-50 to-teal-50 p-6 rounded-3xl border border-indigo-100/50 shadow-inner relative overflow-hidden">
        <div class="absolute top-0 right-0 w-32 h-32 bg-white rounded-full mix-blend-overlay filter blur-xl opacity-50"></div>
        <p class="text-sm uppercase tracking-widest text-teal-600 font-bold mb-4">तुमचे आजचे अचूक वय</p>
        
        <div class="flex justify-center items-center gap-3 md:gap-5">
          <div class="flex flex-col items-center bg-white/60 p-3 rounded-2xl shadow-sm border border-white min-w-[80px]">
            <span id="resYears" class="text-4xl md:text-5xl font-black text-transparent bg-clip-text bg-gradient-to-b from-indigo-700 to-indigo-900 drop-shadow-sm">-</span>
            <span class="text-xs uppercase font-bold text-slate-500 mt-1">वर्षे</span>
          </div>
          
          <div class="font-light text-3xl text-indigo-200">:</div>
          
          <div class="flex flex-col items-center bg-white/60 p-3 rounded-2xl shadow-sm border border-white min-w-[80px]">
            <span id="resMonths" class="text-4xl md:text-5xl font-black text-transparent bg-clip-text bg-gradient-to-b from-indigo-700 to-indigo-900 drop-shadow-sm">-</span>
            <span class="text-xs uppercase font-bold text-slate-500 mt-1">महिने</span>
          </div>
          
          <div class="font-light text-3xl text-indigo-200">:</div>
          
          <div class="flex flex-col items-center bg-white/60 p-3 rounded-2xl shadow-sm border border-white min-w-[80px]">
            <span id="resDays" class="text-4xl md:text-5xl font-black text-transparent bg-clip-text bg-gradient-to-b from-indigo-700 to-indigo-900 drop-shadow-sm">-</span>
            <span class="text-xs uppercase font-bold text-slate-500 mt-1">दिवस</span>
          </div>
        </div>
        
        <div id="ageMessage" class="mt-6 text-sm font-bold text-teal-700 bg-teal-100/50 py-2 px-4 rounded-xl inline-block hidden"></div>
      </div>
    </div>
  </div>

  <div class="w-full min-h-[150px] bg-slate-50 border border-slate-200 rounded-3xl flex items-center justify-center text-slate-400 text-sm shadow-inner relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(#e5e7eb_1px,transparent_1px)] [background-size:16px_16px] opacity-50"></div>
    <span class="relative z-10 flex items-center gap-2"><i class="fa-solid fa-ad"></i> जाहीरात (Ad Space)</span>
  </div> 
</div>

<script>
  const initAgeCalc = () => {
    const dobInput = document.getElementById('dobInput') as HTMLInputElement;
    const calculateBtn = document.getElementById('calculateAgeBtn');
    const resultBox = document.getElementById('ageResultBox');
    const resYears = document.getElementById('resYears');
    const resMonths = document.getElementById('resMonths');
    const resDays = document.getElementById('resDays');
    const ageMessage = document.getElementById('ageMessage');

    if(!calculateBtn || !dobInput) return;

    // Set max date to today
    const today = new Date();
    const dd = String(today.getDate()).padStart(2, '0');
    const mm = String(today.getMonth() + 1).padStart(2, '0'); //January is 0!
    const yyyy = today.getFullYear();
    dobInput.max = `${yyyy}-${mm}-${dd}`;

    const newBtn = calculateBtn.cloneNode(true);
    calculateBtn.parentNode.replaceChild(newBtn, calculateBtn);

    function triggerError(element) {
      element.classList.add('animate-shake', 'ring-4', 'ring-red-500/50');
      setTimeout(() => element.classList.remove('animate-shake', 'ring-4', 'ring-red-500/50'), 600);
      resultBox.classList.remove('scale-100', 'opacity-100');
      resultBox.classList.add('scale-95', 'opacity-0');
      setTimeout(() => resultBox.classList.add('hidden'), 500);
    }

    newBtn.addEventListener('click', () => {
      const dobVal = dobInput.value;
      
      if (!dobVal) {
        triggerError(newBtn);
        return;
      }

      const dobDate = new Date(dobVal);
      const currentDate = new Date();

      if (dobDate > currentDate) {
        triggerError(newBtn);
        return;
      }

      let y1 = dobDate.getFullYear();
      let m1 = dobDate.getMonth() + 1;
      let d1 = dobDate.getDate();

      let y2 = currentDate.getFullYear();
      let m2 = currentDate.getMonth() + 1;
      let d2 = currentDate.getDate();

      let exactYears, exactMonths, exactDays;

      exactYears = y2 - y1;

      if (m2 >= m1) {
        exactMonths = m2 - m1;
      } else {
        exactYears--;
        exactMonths = 12 + m2 - m1;
      }

      if (d2 >= d1) {
        exactDays = d2 - d1;
      } else {
        exactMonths--;
        // get days of previous month
        let prevMonth = m2 - 1 === 0 ? 12 : m2 - 1;
        let prevMonthYear = prevMonth === 12 ? y2 - 1 : y2;
        let daysInPrevMonth = new Date(prevMonthYear, prevMonth, 0).getDate();
        
        exactDays = daysInPrevMonth + d2 - d1;
        if (exactMonths < 0) {
          exactMonths = 11;
          exactYears--;
        }
      }

      // Animate numbers
      animateValue(resYears, 0, exactYears, 1000);
      animateValue(resMonths, 0, exactMonths, 1000);
      animateValue(resDays, 0, exactDays, 1000);
      
      if(exactMonths === 0 && exactDays === 0 && exactYears > 0) {
        ageMessage.innerHTML = '🎉 तुम्हाला वाढदिवसाच्या हार्दिक शुभेच्छा!';
        ageMessage.classList.remove('hidden');
      } else {
        ageMessage.classList.add('hidden');
      }

      resultBox.classList.remove('hidden');
      // small delay to allow display block to apply before animating opacity/transform
      setTimeout(() => {
        resultBox.classList.remove('scale-95', 'opacity-0');
        resultBox.classList.add('scale-100', 'opacity-100');
      }, 50);
    });
    
    function animateValue(obj, start, end, duration) {
      if (!obj) return;
      let startTimestamp = null;
      const step = (timestamp) => {
        if (!startTimestamp) startTimestamp = timestamp;
        const progress = Math.min((timestamp - startTimestamp) / duration, 1);
        // easeOutQuart
        const easeProgress = 1 - Math.pow(1 - progress, 4);
        obj.innerHTML = Math.floor(easeProgress * (end - start) + start);
        if (progress < 1) {
          window.requestAnimationFrame(step);
        } else {
          obj.innerHTML = end;
        }
      };
      window.requestAnimationFrame(step);
    }
  };

  document.addEventListener('DOMContentLoaded', initAgeCalc);
  document.addEventListener('astro:page-load', initAgeCalc);
</script>

<style>
  .animate-shake { animation: shake 0.5s cubic-bezier(.36,.07,.19,.97) both; }
  @keyframes shake {
    10%, 90% { transform: translate3d(-1px, 0, 0); }
    20%, 80% { transform: translate3d(2px, 0, 0); }
    30%, 50%, 70% { transform: translate3d(-4px, 0, 0); }
    40%, 60% { transform: translate3d(4px, 0, 0); }
  }
  
  .animate-blob {
    animation: blob 7s infinite;
  }
  .animation-delay-2000 {
    animation-delay: 2s;
  }
  .animation-delay-4000 {
    animation-delay: 4s;
  }
  @keyframes blob {
    0% { transform: translate(0px, 0px) scale(1); }
    33% { transform: translate(30px, -50px) scale(1.1); }
    66% { transform: translate(-20px, 20px) scale(0.9); }
    100% { transform: translate(0px, 0px) scale(1); }
  }
</style>
