---
// Premium EMI Dashboard & Calculator - Logicpath Systems
// Added: Yearly vs Monthly Toggle
---

<div class="min-h-screen bg-slate-50 font-['Mukta'] py-12 px-4 sm:px-6 lg:px-8 text-slate-800 selection:bg-indigo-200">
  
  <div class="max-w-7xl mx-auto space-y-8 min-w-0" id="pdf-export-area">
    
    <div id="pdf-watermark" class="hidden text-center text-slate-400 text-sm font-bold uppercase tracking-[0.3em] mb-8">
      Generated by Logicpath Systems
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      
      <div class="lg:col-span-5 bg-white rounded-[2rem] shadow-sm border border-slate-200 p-8 flex flex-col h-full min-w-0">
        <div class="mb-10">
          <h2 class="text-3xl font-black text-[#1e293b] mb-1 tracking-tight">EMI कॅल्क्युलेटर</h2>
          <p class="text-slate-500 font-medium text-base">तुमच्या कर्जाचे अचूक नियोजन करा</p>
        </div>

        <div class="space-y-10 flex-1">
          <div class="space-y-3 group">
            <div class="flex justify-between items-end border-b-2 border-slate-200 pb-2 group-focus-within:border-indigo-600 transition-colors">
              <label class="font-bold text-slate-500 text-sm group-focus-within:text-indigo-600 transition-colors">कर्जाची रक्कम (₹)</label>
              <input type="number" id="loanAmount" value="1770000" class="w-40 text-right font-black text-2xl text-slate-900 bg-transparent border-none focus:ring-0 outline-none p-0" />
            </div>
            <input type="range" id="loanAmountSlider" min="50000" max="10000000" step="50000" value="1770000" class="custom-slider w-full" />
          </div>

          <div class="space-y-3 group">
            <div class="flex justify-between items-end border-b-2 border-slate-200 pb-2 group-focus-within:border-indigo-600 transition-colors">
              <label class="font-bold text-slate-500 text-sm group-focus-within:text-indigo-600 transition-colors">व्याजदर (%)</label>
              <input type="number" id="interestRate" value="8.5" step="0.1" class="w-24 text-right font-black text-2xl text-slate-900 bg-transparent border-none focus:ring-0 outline-none p-0" />
            </div>
            <input type="range" id="interestRateSlider" min="1" max="20" step="0.1" value="8.5" class="custom-slider w-full" />
          </div>

          <div class="space-y-3 group">
            <div class="flex justify-between items-end border-b-2 border-slate-200 pb-2 group-focus-within:border-indigo-600 transition-colors">
              <label class="font-bold text-slate-500 text-sm group-focus-within:text-indigo-600 transition-colors">कालावधी (वर्षे)</label>
              <input type="number" id="loanTenure" value="7" class="w-24 text-right font-black text-2xl text-slate-900 bg-transparent border-none focus:ring-0 outline-none p-0" />
            </div>
            <input type="range" id="loanTenureSlider" min="1" max="30" step="1" value="7" class="custom-slider w-full" />
          </div>
        </div>
      </div>

      <div class="lg:col-span-7 flex flex-col gap-6 min-w-0">
        
        <div class="bg-[#293275] rounded-[2rem] p-8 md:p-10 text-white shadow-lg flex flex-col sm:flex-row items-center justify-between gap-8 relative overflow-hidden">
          <div class="absolute top-0 right-0 w-64 h-64 bg-indigo-500/30 rounded-full blur-[80px] -translate-y-1/2 translate-x-1/2 pointer-events-none"></div>
          
          <div class="relative z-10 w-full text-center sm:text-left">
            <div class="inline-flex items-center gap-2 mb-3">
              <div class="w-2 h-2 rounded-full bg-emerald-400"></div>
              <span class="text-indigo-200 font-semibold text-sm tracking-wide">तुमचा मासिक हप्ता (EMI)</span>
            </div>
            <div id="emiValue" class="text-5xl sm:text-6xl font-black tracking-tighter drop-shadow-md mb-4">₹०</div>
            <p class="text-indigo-200/80 text-sm max-w-[280px] leading-relaxed mx-auto sm:mx-0">हा हप्ता तुमच्या दिलेल्या माहितीनुसार काढला आहे. बँकेचे नियम बदलू शकतात.</p>
          </div>

          <div class="w-48 h-48 relative z-10 shrink-0 bg-white/5 rounded-full p-4 border border-white/10 backdrop-blur-md">
             <canvas id="emiPieChart"></canvas>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 min-w-0">
          
          <div class="bg-white rounded-[1.5rem] border border-slate-200 shadow-sm overflow-hidden flex flex-col min-w-0">
            <div class="bg-slate-50 px-5 py-3 border-b border-slate-100 flex justify-between items-center">
              <h4 class="font-bold text-slate-700 text-sm">Loan Impact Overview</h4>
              <span class="text-[10px] font-bold uppercase tracking-wider bg-slate-200 text-slate-500 px-2 py-1 rounded">महिना १</span>
            </div>
            <div class="p-5 flex-1 flex flex-col justify-center gap-3">
              <div class="flex justify-between items-center py-2 border-b border-slate-100">
                <div class="flex items-center gap-2">
                  <div class="w-2.5 h-2.5 rounded bg-indigo-500"></div>
                  <span class="text-slate-600 font-medium text-sm">मुद्दल (Principal)</span>
                </div>
                <span id="m1Principal" class="font-bold text-slate-800">₹०</span>
              </div>
              <div class="flex justify-between items-center py-2 border-b border-slate-100">
                <div class="flex items-center gap-2">
                  <div class="w-2.5 h-2.5 rounded bg-[#fb923c]"></div>
                  <span class="text-slate-600 font-medium text-sm">व्याज (Interest)</span>
                </div>
                <span id="m1Interest" class="font-bold text-slate-800">₹०</span>
              </div>
              <div class="flex justify-between items-center mt-2 bg-orange-50 border border-orange-200 rounded-lg px-3 py-2">
                <span class="text-orange-900 font-bold text-sm">मासिक हप्ता (EMI)</span>
                <span id="m1TotalEmi" class="font-black text-lg text-orange-600">₹०</span>
              </div>
            </div>
          </div>

          <div class="flex flex-col gap-4 min-w-0">
            <div class="bg-orange-50/70 p-5 rounded-[1.5rem] border border-orange-100 shadow-sm flex-1 flex flex-col justify-center">
              <span class="text-orange-800/60 text-xs font-bold uppercase tracking-widest mb-1">एकूण व्याज</span>
              <div id="totalInterest" class="text-3xl font-black text-orange-600 tracking-tight whitespace-nowrap overflow-hidden text-ellipsis">₹०</div>
            </div>
            <div class="bg-white p-5 rounded-[1.5rem] border border-slate-200 shadow-sm flex-1 flex flex-col justify-center">
              <span class="text-slate-400 text-xs font-bold uppercase tracking-widest mb-1">एकूण परतफेड</span>
              <div id="totalPayment" class="text-3xl font-black text-slate-800 tracking-tight whitespace-nowrap overflow-hidden text-ellipsis">₹०</div>
            </div>
          </div>

        </div>

        <div class="flex flex-col sm:flex-row gap-4 mt-2">
          <button id="exportPdfBtn" class="flex-1 bg-slate-800 hover:bg-[#293275] text-white font-bold text-base py-4 px-6 rounded-xl transition-all duration-300 flex items-center justify-center gap-2 active:scale-95 shadow-md">
            <i class="fa-solid fa-download"></i> <span id="btnText">Download Report</span>
          </button>
          <a href="#schedule-table" class="bg-white border border-slate-300 hover:border-indigo-400 text-slate-700 font-bold py-4 px-8 rounded-xl transition-all flex items-center justify-center gap-2 active:scale-95 shadow-sm">
            <i class="fa-solid fa-table"></i> View Table
          </a>
        </div>
        
      </div>
    </div>

    <div id="schedule-table" class="bg-white rounded-[2rem] shadow-sm border border-slate-200 p-6 md:p-8 scroll-mt-10 min-w-0">
      
      <div class="mb-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
          <h3 class="text-2xl font-black text-[#1e293b]">परतफेड वेळापत्रक <span class="text-indigo-600">(Schedule)</span></h3>
          <p class="text-slate-500 font-medium text-sm mt-1">दरवर्षी तुमची मुद्दल आणि व्याजाची रक्कम कशी विभागली जाते हे तपासा.</p>
        </div>
        
        <div class="flex bg-slate-100 p-1 rounded-xl shadow-inner border border-slate-200">
          <button id="toggleYearly" class="px-5 py-2 text-sm font-bold rounded-lg bg-white text-indigo-700 shadow-sm transition-all duration-300">वार्षिक (Yearly)</button>
          <button id="toggleMonthly" class="px-5 py-2 text-sm font-bold rounded-lg text-slate-500 hover:text-slate-800 transition-all duration-300">मासिक (Monthly)</button>
        </div>
      </div>

      <div class="block w-full overflow-x-auto custom-scrollbar border border-slate-100 rounded-xl relative max-h-[600px] overflow-y-auto">
        <table class="w-full text-left border-collapse min-w-[1000px] table-auto">
          <thead class="bg-slate-50 sticky top-0 z-10 shadow-sm border-b border-slate-200">
            <tr>
              <th id="periodHeader" class="py-4 px-5 text-xs uppercase tracking-widest font-black text-slate-500 whitespace-nowrap w-24">वर्ष</th>
              <th class="py-4 px-5 text-xs uppercase tracking-widest font-black text-slate-500 whitespace-nowrap">मुद्दल (Principal)</th>
              <th class="py-4 px-5 text-xs uppercase tracking-widest font-black text-orange-500 whitespace-nowrap">व्याज (Interest)</th>
              <th id="totalColHeader" class="py-4 px-5 text-xs uppercase tracking-widest font-black text-indigo-700 whitespace-nowrap bg-indigo-50/50">वार्षिक रक्कम</th>
              <th class="py-4 px-5 text-xs uppercase tracking-widest font-black text-slate-500 whitespace-nowrap w-48">रक्कम प्रमाण (Ratio)</th>
              <th class="py-4 px-5 text-xs uppercase tracking-widest font-black text-indigo-700 text-right whitespace-nowrap">शिल्लक (Balance)</th>
            </tr>
          </thead>
          <tbody id="amortizationBody" class="divide-y divide-slate-100">
            </tbody>
        </table>
      </div>
    </div>

  </div>
</div>

<script is:inline src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

<script>
  let emiChart = null;
  let currentTableView = 'yearly'; // Global state for toggle
  const formatter = new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR', maximumFractionDigits: 0 });

  // Toggle Logic
  const btnYearly = document.getElementById('toggleYearly');
  const btnMonthly = document.getElementById('toggleMonthly');

  btnYearly.addEventListener('click', () => {
    currentTableView = 'yearly';
    btnYearly.classList.add('bg-white', 'text-indigo-700', 'shadow-sm');
    btnYearly.classList.remove('text-slate-500', 'hover:text-slate-800');
    btnMonthly.classList.remove('bg-white', 'text-indigo-700', 'shadow-sm');
    btnMonthly.classList.add('text-slate-500', 'hover:text-slate-800');
    calculateEMI();
  });

  btnMonthly.addEventListener('click', () => {
    currentTableView = 'monthly';
    btnMonthly.classList.add('bg-white', 'text-indigo-700', 'shadow-sm');
    btnMonthly.classList.remove('text-slate-500', 'hover:text-slate-800');
    btnYearly.classList.remove('bg-white', 'text-indigo-700', 'shadow-sm');
    btnYearly.classList.add('text-slate-500', 'hover:text-slate-800');
    calculateEMI();
  });

  const calculateEMI = () => {
    const P = parseFloat(document.getElementById('loanAmount').value);
    const R = parseFloat(document.getElementById('interestRate').value);
    const N_years = parseFloat(document.getElementById('loanTenure').value);

    if (!P || !R || !N_years) return;

    const monthlyRate = R / 12 / 100;
    const N_months = N_years * 12;
    const emi = (P * monthlyRate * Math.pow(1 + monthlyRate, N_months)) / (Math.pow(1 + monthlyRate, N_months) - 1);
    
    const totalPayable = emi * N_months;
    const totalInt = totalPayable - P;

    const m1Interest = P * monthlyRate;
    const m1Principal = emi - m1Interest;

    // Update Dashboard Values
    document.getElementById('emiValue').innerText = formatter.format(emi);
    document.getElementById('totalInterest').innerText = formatter.format(totalInt);
    document.getElementById('totalPayment').innerText = formatter.format(totalPayable);
    
    // Update Month 1 Overview
    document.getElementById('m1Principal').innerText = formatter.format(m1Principal);
    document.getElementById('m1Interest').innerText = formatter.format(m1Interest);
    document.getElementById('m1TotalEmi').innerText = formatter.format(emi);

    updateChart(P, totalInt);
    generateAmortizationSchedule(P, monthlyRate, N_years, emi);
  };

  const updateChart = (principal, interest) => {
    const ctx = document.getElementById('emiPieChart').getContext('2d');
    if (emiChart) emiChart.destroy();
    
    Chart.defaults.font.family = "'Mukta', sans-serif";
    emiChart = new Chart(ctx, {
      type: 'doughnut',
      data: {
        datasets: [{
          data: [principal, interest],
          backgroundColor: ['#6366f1', '#fb923c'],
          borderWidth: 0,
        }]
      },
      options: { cutout: '75%', responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } }
    });
  };

  const generateAmortizationSchedule = (principal, monthlyRate, years, emi) => {
    const tbody = document.getElementById('amortizationBody');
    const periodHeader = document.getElementById('periodHeader');
    const totalColHeader = document.getElementById('totalColHeader');
    
    let balance = principal;
    let html = '';
    let globalMonthCounter = 1;

    // Update table headers based on state
    if (currentTableView === 'yearly') {
      periodHeader.innerText = 'वर्ष (Year)';
      totalColHeader.innerText = 'वार्षिक रक्कम';
    } else {
      periodHeader.innerText = 'महिना (Month)';
      totalColHeader.innerText = 'मासिक हप्ता (EMI)';
    }

    for (let y = 1; y <= years; y++) {
      let yearlyInterest = 0;
      let yearlyPrincipal = 0;
      
      for (let m = 1; m <= 12; m++) {
        let mInterest = balance * monthlyRate;
        let mPrincipal = emi - mInterest;
        
        balance -= mPrincipal;
        if (balance < 0) balance = 0;

        yearlyInterest += mInterest;
        yearlyPrincipal += mPrincipal;

        // Render Monthly Rows if toggled
        if (currentTableView === 'monthly') {
          const totalMonthly = mPrincipal + mInterest;
          const principalPercent = (mPrincipal / totalMonthly) * 100;
          const interestPercent = 100 - principalPercent;

          html += `
            <tr class="hover:bg-slate-50 transition-colors duration-200">
              <td class="py-3 px-5 font-black text-slate-800 text-sm">${globalMonthCounter}</td>
              <td class="py-3 px-5 font-bold text-slate-600 whitespace-nowrap text-sm">${formatter.format(mPrincipal)}</td>
              <td class="py-3 px-5 font-bold text-orange-500 whitespace-nowrap text-sm">${formatter.format(mInterest)}</td>
              <td class="py-3 px-5 font-black text-indigo-700 whitespace-nowrap bg-indigo-50/30 text-sm">${formatter.format(totalMonthly)}</td>
              <td class="py-3 px-5">
                <div class="w-full h-1.5 bg-slate-200 rounded-full overflow-hidden flex">
                  <div class="h-full bg-indigo-500" style="width: ${principalPercent}%"></div>
                  <div class="h-full bg-orange-400" style="width: ${interestPercent}%"></div>
                </div>
              </td>
              <td class="py-3 px-5 font-black text-slate-900 text-right whitespace-nowrap text-sm">${formatter.format(balance)}</td>
            </tr>
          `;
        }
        globalMonthCounter++;
      }
      
      // Render Yearly Rows if toggled
      if (currentTableView === 'yearly') {
        const totalYearly = yearlyPrincipal + yearlyInterest;
        const principalPercent = (yearlyPrincipal / totalYearly) * 100;
        const interestPercent = 100 - principalPercent;

        html += `
          <tr class="hover:bg-slate-50 transition-colors duration-200">
            <td class="py-4 px-5 font-black text-slate-800">${y}</td>
            <td class="py-4 px-5 font-bold text-slate-600 whitespace-nowrap">${formatter.format(yearlyPrincipal)}</td>
            <td class="py-4 px-5 font-bold text-orange-500 whitespace-nowrap">${formatter.format(yearlyInterest)}</td>
            <td class="py-4 px-5 font-black text-indigo-700 whitespace-nowrap bg-indigo-50/30">${formatter.format(totalYearly)}</td>
            <td class="py-4 px-5">
              <div class="w-full h-2 bg-slate-200 rounded-full overflow-hidden flex mb-1">
                <div class="h-full bg-indigo-500" style="width: ${principalPercent}%"></div>
                <div class="h-full bg-orange-400" style="width: ${interestPercent}%"></div>
              </div>
              <div class="flex justify-between text-[10px] font-black uppercase tracking-widest">
                <span class="text-indigo-600">${Math.round(principalPercent)}%</span>
                <span class="text-orange-500">${Math.round(interestPercent)}%</span>
              </div>
            </td>
            <td class="py-4 px-5 font-black text-slate-900 text-right whitespace-nowrap">${formatter.format(balance)}</td>
          </tr>
        `;
      }
    }
    tbody.innerHTML = html;
  };

  const syncInputs = (textId, sliderId) => {
    const text = document.getElementById(textId);
    const slider = document.getElementById(sliderId);
    text.addEventListener('input', () => { slider.value = text.value; calculateEMI(); });
    slider.addEventListener('input', () => { text.value = slider.value; calculateEMI(); });
  };

  const initPdfExport = () => {
    const btn = document.getElementById('exportPdfBtn');
    if (!btn) return;
    
    btn.addEventListener('click', () => {
      const element = document.getElementById('pdf-export-area');
      const watermark = document.getElementById('pdf-watermark');
      
      btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin text-slate-300"></i> <span class="text-white">PDF तयार होत आहे...</span>';
      btn.classList.replace('bg-slate-800', 'bg-black');
      btn.classList.add('cursor-not-allowed');
      watermark.classList.remove('hidden');

      const opt = {
        margin:       0.3,
        filename:     'EMI_Report_Logicpath_Systems.pdf',
        image:        { type: 'jpeg', quality: 0.98 },
        html2canvas:  { scale: 2, useCORS: true, windowWidth: 1200 },
        jsPDF:        { unit: 'in', format: 'a4', orientation: 'portrait' }
      };

      html2pdf().set(opt).from(element).save().then(() => {
        btn.innerHTML = '<i class="fa-solid fa-download"></i> <span id="btnText">Download Report</span>';
        btn.classList.replace('bg-black', 'bg-slate-800');
        btn.classList.remove('cursor-not-allowed');
        watermark.classList.add('hidden');
      });
    });
  };

  document.addEventListener('DOMContentLoaded', () => {
    syncInputs('loanAmount', 'loanAmountSlider');
    syncInputs('interestRate', 'interestRateSlider');
    syncInputs('loanTenure', 'loanTenureSlider');
    calculateEMI();
    initPdfExport();
  });
</script>

<style>
  /* Premium Fintech Sliders */
  .custom-slider {
    -webkit-appearance: none;
    height: 4px;
    background: #e2e8f0;
    border-radius: 8px;
    outline: none;
    position: relative;
    top: -5px;
  }
  .custom-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #4f46e5;
    cursor: pointer;
    border: 4px solid #ffffff;
    box-shadow: 0 0 0 1px #cbd5e1, 0 4px 6px -1px rgb(0 0 0 / 0.1);
    transition: transform 0.1s;
  }
  .custom-slider::-webkit-slider-thumb:active {
    transform: scale(1.15);
    background: #3730a3;
  }

  /* Stabilized Scrollbars */
  .custom-scrollbar::-webkit-scrollbar { height: 8px; width: 8px; }
  .custom-scrollbar::-webkit-scrollbar-track { background: #f8fafc; border-radius: 0 0 0.75rem 0.75rem; }
  .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; border: 2px solid #f8fafc; }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
</style>