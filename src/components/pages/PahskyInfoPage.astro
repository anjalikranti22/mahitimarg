<script is:inline>
    function getSlabPercentage(dateString) {
        const npaDate = new Date(dateString);

        // तारखांच्या मर्यादा (Slab Boundaries)
        const slab1End = new Date('2021-09-30');
        const slab2End = new Date('2022-09-30');
        const slab3End = new Date('2023-09-30');
        const slab4End = new Date('2024-09-30');
        const slab5End = new Date('2025-09-30');

        // तारखेनुसार टक्केवारी ठरवणे
        if (npaDate <= slab1End) return 0.35; // ३०/०९/२०२१ पूर्वी
        if (npaDate > slab1End && npaDate <= slab2End) return 0.45; // ०१/१०/२०२१ ते ३०/०९/२०२२
        if (npaDate > slab2End && npaDate <= slab3End) return 0.55; // ०१/१०/२०२२ ते ३०/०९/२०२३
        if (npaDate > slab3End && npaDate <= slab4End) return 0.70; // ०१/१०/२०२३ ते ३०/०९/२०२४
        if (npaDate > slab4End && npaDate <= slab5End) return 0.85; // ०१/०९/२०२४ ते ३०/०९/२०२५

        return null; // योजनेच्या तारखेबाहेरील कर्ज असल्यास
    }

    function calculateFarmerOTS(npaAmount, npaDateString) {
        if (!npaAmount || npaAmount <= 0) {
            return { success: false, message: "कृपया योग्य रक्कम टाका." };
        }

        const npaPercentage = getSlabPercentage(npaDateString);
        if (npaPercentage === null) {
            return { success: false, message: "तुमची NPA तारीख या योजनेच्या मर्यादेत बसत नाही. (३०/०९/२०२५ नंतरची तारीख असू नये)" };
        }

        const maxGovtLimit = 200000; // २ लाख रुपयांची कमाल मर्यादा
        
        const settlementAmount = Math.round(npaAmount * npaPercentage);
        const bankSacrifice = npaAmount - settlementAmount;

        let govtPays = 0;
        let farmerPays = 0;

        if (settlementAmount <= maxGovtLimit) {
            govtPays = settlementAmount;
            farmerPays = 0;
        } else {
            govtPays = maxGovtLimit;
            farmerPays = settlementAmount - maxGovtLimit;
        }

        const formatCurrency = (num) => '₹ ' + num.toLocaleString('mr-IN');

        return {
            success: true,
            data: {
                appliedPercentage: (npaPercentage * 100) + '%',
                formatted: {
                    govtPays: formatCurrency(govtPays),
                    farmerPays: formatCurrency(farmerPays),
                    bankSacrifice: formatCurrency(bankSacrifice)
                }
            }
        };
    }

    window.calculateOTS = function() {
        const amountInput = document.getElementById('npaAmount');
        const dateInput = document.getElementById('npaDate');
        
        if (!amountInput || !dateInput) return;
        
        const amount = parseFloat(amountInput.value);
        const dateString = dateInput.value;
        
        if(!dateString) {
            alert("कृपया NPA तारीख निवडा.");
            return;
        }

        const result = calculateFarmerOTS(amount, dateString);

        if (!result.success) {
            alert(result.message);
            return;
        }

        const govShareEl = document.getElementById('govShare');
        const farmerShareEl = document.getElementById('farmerShare');
        const bankSacrificeEl = document.getElementById('bankSacrifice');
        const resultSection = document.getElementById('resultSection');
        const appliedSlabEl = document.getElementById('appliedSlab');

        if(govShareEl) govShareEl.innerText = result.data.formatted.govtPays;
        if(farmerShareEl) farmerShareEl.innerText = result.data.formatted.farmerPays;
        if(bankSacrificeEl) bankSacrificeEl.innerText = result.data.formatted.bankSacrifice;
        if(appliedSlabEl) appliedSlabEl.innerText = "(लागू झालेला टप्पा: " + result.data.appliedPercentage + " परतफेड)";

        if(resultSection) {
            resultSection.classList.remove('hidden');
            resultSection.style.display = 'block';
        }
    };
</script>

