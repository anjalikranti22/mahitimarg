---
// VillageEligibilityChecker.astro
// This is an interactive component that loads Maharashtra village data dynamically 
// and provides a 3-step dropdown UI to check eligibility.
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="village-eligibility-checker">
  <h3>{t('checker.title')}</h3>
  <p class="eligibility-desc">{t('checker.desc')}</p>

  <div class="checker-form">
    <div class="form-group">
      <label for="district-select">{t('checker.district')}</label>
      <select id="district-select" disabled>
        <option value="">{t('checker.district.opt')}</option>
      </select>
    </div>

    <div class="form-group">
      <label for="taluka-select">{t('checker.taluka')}</label>
      <select id="taluka-select" disabled>
        <option value="">{t('checker.taluka.opt')}</option>
      </select>
    </div>

    <div class="form-group">
      <label for="village-select">{t('checker.village')}</label>
      <select id="village-select" disabled>
        <option value="">{t('checker.village.opt')}</option>
      </select>
    </div>

    <div class="form-group">
      <label for="loanStatus">{t('checker.loan.status')}</label>
      <select id="loanStatus">
        <option value="default">{t('checker.loan.status.opt')}</option>
        <option value="thakit">{t('checker.loan.thakit')}</option>
        <option value="niyamit">{t('checker.loan.niyamit')}</option>
      </select>
      <span class="info-note">{t('checker.loan.note')}</span>
    </div>

    <div class="form-group" id="loanAmountGroup">
      <label for="loanAmount">{t('checker.loan.amount')}</label>
      <input type="number" id="loanAmount" placeholder={t('checker.loan.ph')} min="0" />
    </div>

    <button id="check-eligibility-btn" class="btn-check" disabled>{t('checker.btn.check')}</button>
  </div>

  <div id="eligibility-result" class="eligibility-result hidden">
    <!-- Result goes here -->
  </div>
</div>

<style>
  .village-eligibility-checker {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 16px;
    padding: 2rem;
    margin: 2.5rem 0;
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.05), 0 1px 3px rgba(0, 0, 0, 0.02);
    transition: all 0.3s ease;
  }

  .village-eligibility-checker h3 {
    margin-top: 0;
    color: #0f172a;
    font-size: 1.35rem;
    font-weight: 700;
    font-family: 'Mukta', sans-serif;
  }

  .eligibility-desc {
    color: #475569;
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }

  .checker-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-group label {
    font-weight: 600;
    color: #334155;
    font-size: 0.9rem;
    font-family: 'Mukta', sans-serif;
  }

  .form-group select, .form-group input[type="number"] {
    padding: 0.75rem;
    border: 1.5px solid #cbd5e1;
    border-radius: 10px;
    font-size: 0.95rem;
    background-color: #ffffff;
    color: #0f172a;
    transition: all 0.2s ease-in-out;
  }

  .form-group select:focus, .form-group input[type="number"]:focus {
    outline: none;
    border-color: #2563eb;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
  }

  .form-group select:disabled, .form-group input[type="number"]:disabled {
    background-color: #f1f5f9;
    color: #94a3b8;
    border-color: #e2e8f0;
    cursor: not-allowed;
  }

  .btn-check {
    margin-top: 0.5rem;
    padding: 0.8rem 1.5rem;
    background-color: #16a34a;
    color: white;
    border: none;
    border-radius: 10px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    font-family: 'Mukta', sans-serif;
  }

  .btn-check:hover:not(:disabled) {
    background-color: #15803d;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(22, 163, 74, 0.2);
  }

  .btn-check:active:not(:disabled) {
    transform: scale(0.97);
  }

  .btn-check:focus {
    outline: none;
    box-shadow: 0 0 0 3px rgba(22, 163, 74, 0.35);
  }

  .btn-check:disabled {
    background-color: #cbd5e1;
    color: #94a3b8;
    cursor: not-allowed;
  }

  .eligibility-result {
    margin-top: 1.5rem;
    padding: 1.25rem;
    border-radius: 10px;
    text-align: left;
    font-size: 1.05rem;
    line-height: 1.6;
    animation: fadeIn 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    font-family: 'Mukta', sans-serif;
  }

  .eligibility-result.success {
    background-color: #ecfdf5;
    color: #065f46;
    border: 1px solid #a7f3d0;
  }

  .eligibility-result.error {
    background-color: #fef2f2;
    color: #991b1b;
    border: 1px solid #fecaca;
  }

  .info-note {
    font-size: 0.8rem;
    color: #64748b;
    margin-top: -0.25rem;
    line-height: 1.4;
  }

  .hidden {
    display: none;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (min-width: 768px) {
    .checker-form {
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: 1.5rem;
      row-gap: 1.25rem;
      align-items: start;
    }
    .btn-check {
      grid-column: 1 / -1;
    }
  }
</style>

<script id="checker-translations" type="application/json" set:html={JSON.stringify({
  loading: t('checker.js.loading'),
  error: t('checker.js.error'),
  distOpt: t('checker.district.opt'),
  talOpt: t('checker.taluka.opt'),
  vilOpt: t('checker.village.opt'),
  errSelectAll: t('checker.js.err.select_all'),
  errSelectType: t('checker.js.err.select_type'),
  errAmount: t('checker.js.err.amount'),
  succThakit: t('checker.js.success.thakit'),
  errLimit: t('checker.js.err.limit'),
  succNiyamit: t('checker.js.success.niyamit')
})}></script>

<script>
  interface Translations {
    [key: string]: string;
  }

  type VillageDataStructure = Record<string, Record<string, string[]>>;

  let cachedVillageData: VillageDataStructure | null = null;
  
  function getTranslations(): Translations {
    const el = document.getElementById('checker-translations');
    return el && el.textContent ? JSON.parse(el.textContent) : {};
  }
  
  function t(key: string, params: Record<string, string> = {}): string {
    const dict = getTranslations();
    let str = dict[key] || '';
    for(let k in params) {
        str = str.replace(`{${k}}`, params[k]);
    }
    return str;
  }

  async function loadData() {
    const distSelect = document.getElementById('district-select') as HTMLSelectElement | null;
    if (!distSelect) return;

    try {
      if (cachedVillageData) {
        populateDistricts(cachedVillageData);
        return;
      }

      distSelect.innerHTML = `<option value="">${t('loading')}</option>`;
      
      const response = await fetch('/data/villages.json');
      const data = await response.json() as VillageDataStructure;
      cachedVillageData = data;
      
      populateDistricts(data);
    } catch (err) {
      console.error("Failed to load village data", err);
      distSelect.innerHTML = `<option value="">${t('error')}</option>`;
    }
  }

  function populateDistricts(villageData: VillageDataStructure) {
    const distSelect = document.getElementById('district-select') as HTMLSelectElement | null;
    if (!distSelect) return;

    distSelect.innerHTML = `<option value="">${t('distOpt')}</option>`;
    
    if (!villageData || typeof villageData !== 'object') return;
    
    const districts = Object.keys(villageData).sort();
    
    districts.forEach(dist => {
      const opt = document.createElement('option');
      opt.value = dist;
      opt.textContent = dist;
      distSelect.appendChild(opt);
    });
    
    distSelect.disabled = false;
  }

  document.addEventListener('astro:page-load', () => {
    const distSelect = document.getElementById('district-select') as HTMLSelectElement | null;
    if (!distSelect) return;

    loadData();

    const talSelect = document.getElementById('taluka-select') as HTMLSelectElement | null;
    const vilSelect = document.getElementById('village-select') as HTMLSelectElement | null;
    const checkBtn = document.getElementById('check-eligibility-btn') as HTMLButtonElement | null;
    const resultDiv = document.getElementById('eligibility-result') as HTMLDivElement | null;
    const loanStatusEl = document.getElementById('loanStatus') as HTMLSelectElement | null;
    const loanAmountGroup = document.getElementById('loanAmountGroup') as HTMLDivElement | null;
    const loanAmountEl = document.getElementById('loanAmount') as HTMLInputElement | null;

    if (!talSelect || !vilSelect || !checkBtn || !resultDiv || !loanStatusEl || !loanAmountGroup || !loanAmountEl) return;

    distSelect.addEventListener('change', (e) => {
      const target = e.target as HTMLSelectElement | null;
      if (!target) return;
      const selectedDist = target.value;
      
      talSelect.innerHTML = `<option value="">${t('talOpt')}</option>`;
      vilSelect.innerHTML = `<option value="">${t('vilOpt')}</option>`;
      talSelect.disabled = true;
      vilSelect.disabled = true;
      checkBtn.disabled = true;
      resultDiv.classList.add('hidden');
      
      if (selectedDist && cachedVillageData && cachedVillageData[selectedDist]) {
        const talukas = Object.keys(cachedVillageData[selectedDist]).sort();
        talukas.forEach(tal => {
          const opt = document.createElement('option');
          opt.value = tal;
          opt.textContent = tal;
          talSelect.appendChild(opt);
        });
        talSelect.disabled = false;
      }
    });

    talSelect.addEventListener('change', (e) => {
      const target = e.target as HTMLSelectElement | null;
      if (!target) return;
      const selectedDist = distSelect.value;
      const selectedTal = target.value;
      
      vilSelect.innerHTML = `<option value="">${t('vilOpt')}</option>`;
      vilSelect.disabled = true;
      checkBtn.disabled = true;
      resultDiv.classList.add('hidden');
      
      if (selectedDist && selectedTal && cachedVillageData && cachedVillageData[selectedDist][selectedTal]) {
        const villages = cachedVillageData[selectedDist][selectedTal].sort();
        villages.forEach(vil => {
          const opt = document.createElement('option');
          opt.value = vil;
          opt.textContent = vil;
          vilSelect.appendChild(opt);
        });
        vilSelect.disabled = false;
      }
    });

    vilSelect.addEventListener('change', (e) => {
      const target = e.target as HTMLSelectElement | null;
      if (!target) return;
      resultDiv.classList.add('hidden');
      if (target.value) {
        checkBtn.disabled = false;
      } else {
        checkBtn.disabled = true;
      }
    });

    loanStatusEl.addEventListener('change', (e) => {
      const target = e.target as HTMLSelectElement | null;
      if (!target) return;
      if (target.value === 'niyamit') {
        loanAmountGroup.style.display = 'none';
      } else {
        loanAmountGroup.style.display = 'flex';
      }
    });

    checkBtn.addEventListener('click', () => {
      const village = vilSelect.value;
      const taluka = talSelect.value;
      const district = distSelect.value;
      const status = loanStatusEl.value;
      const amountStr = loanAmountEl.value;
      
      resultDiv.classList.remove('hidden', 'success', 'error');
      
      if (!village || !taluka || !district) {
          resultDiv.innerHTML = t('errSelectAll');
          resultDiv.className = 'eligibility-result error';
          return;
      }

      if (status === 'default') {
          resultDiv.innerHTML = t('errSelectType');
          resultDiv.className = 'eligibility-result error';
          return;
      }

      if (status === 'thakit') {
          const amount = parseFloat(amountStr);
          if (isNaN(amount) || amount <= 0) {
              resultDiv.innerHTML = t('errAmount');
              resultDiv.className = 'eligibility-result error';
              return;
          }
          if (amount <= 200000) {
              const formattedAmt = amount.toLocaleString('en-IN');
              resultDiv.innerHTML = t('succThakit', {village: village, amount: formattedAmt});
              resultDiv.className = 'eligibility-result success';
          } else {
              resultDiv.innerHTML = t('errLimit');
              resultDiv.className = 'eligibility-result error';
          }
      } else if (status === 'niyamit') {
          resultDiv.innerHTML = t('succNiyamit', {village: village});
          resultDiv.className = 'eligibility-result success';
      }
    });
  });
</script>
