---
// Header.astro
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isEn = lang === 'en';

const navLinks = [
    { label: t('nav.schemes'), icon: 'fa-solid fa-list-check', href: isEn ? '/en/schemes' : '/schemes' },
    { label: t('nav.articles'), icon: 'fa-regular fa-newspaper', href: isEn ? '/en/articles' : '/articles' },
    { label: t('nav.tools'), icon: 'fa-solid fa-screwdriver-wrench', href: isEn ? '/en/tools' : '/tools' },
    { label: t('nav.jobs'), icon: 'fa-solid fa-briefcase', href: isEn ? '/en/jobs' : '/jobs' },
    { label: t('nav.services'), icon: 'fa-solid fa-building-columns', href: isEn ? '/en/services' : '/services' },
    { label: t('nav.training'), icon: 'fa-solid fa-graduation-cap', href: isEn ? '/en/training' : '/training' },
    { label: t('nav.downloads'), icon: 'fa-solid fa-download', href: isEn ? '/en/downloads' : '/downloads' },
    { label: t('nav.finance'), icon: 'fa-solid fa-calculator', href: isEn ? '/en/learn' : '/learn' },
    { label: t('nav.contact'), icon: 'fa-solid fa-headset', href: isEn ? '/en/contact' : '/contact' }
];

const currentPath = Astro.url.pathname;
const localeFreePath = isEn ? currentPath.replace(/^\/en/, '') : currentPath;
const mrUrl = localeFreePath || '/';
const enUrl = `/en${localeFreePath === '/' ? '' : localeFreePath}`;
---
<div class="news-ticker-container" aria-label="Latest Scheme Updates">
    <div class="ticker-label"><i class="fa-solid fa-bullhorn" aria-hidden="true"></i> {t('ticker.label')}</div>
    <div class="ticker-content-wrapper">
        <div class="ticker-content">
            <span><span class="ticker-badge">INFO</span> {t('ticker.content')}</span>
        </div>
    </div>
</div>

<header class="main-header">
    <div class="container nav-container">
        <a href={isEn ? "/en" : "/"} class="logo" aria-label="Go to MahitiMarg Homepage">
            <div class="logo-icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="20" height="20" fill="currentColor">
                    <path d="M512 32c0 113.6-84.6 207.5-194.2 222c-7.1-53.4-30.6-103.3-68.4-141.3C287.3 74.8 340.9 50.4 399.7 45.4C433.8 42.6 470 34.6 512 32zM216 256c0 10.6-2.5 20.6-6.4 29.8C194 322.9 160.8 352 120 352c-48.6 0-88-39.4-88-88c0-40.8 29.1-74 66.2-89.6c9.2-3.9 19.2-6.4 29.8-6.4c53 0 96 43 96 96z" />
                </svg>
            </div>
            MahitiMarg
            <span class="badge-unofficial">Unofficial</span>
        </a>

        <!-- Desktop Navigation -->
        <nav class="desktop-nav" aria-label="Main Navigation">
            <ul class="nav-links">
                {navLinks.map((link) => (
                    <li>
                        <a href={link.href}>
                            <i class={link.icon} aria-hidden="true"></i>
                            <span>{link.label}</span>
                        </a>
                    </li>
                ))}
            </ul>
        </nav>

        <!-- Language Switcher -->
        <div class="header-lang-switcher">
            <a href={mrUrl} class={`lang-btn ${!isEn ? 'active' : ''}`}>मराठी</a>
            <a href={enUrl} class={`lang-btn ${isEn ? 'active' : ''}`}>EN</a>
        </div>
    </div>
</header>
