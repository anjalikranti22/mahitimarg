---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SEO } from 'astro-seo';
import { ClientRouter } from 'astro:transitions';

interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  title: string;
  description?: string;
  image?: string;
  keywords?: string;
  canonical?: string;
  jsonLd?: object;
  breadcrumbs?: BreadcrumbItem[];
}

const {
  title,
  description = "सर्व सरकारी योजना – एकाच ठिकाणी",
  image = "https://mahitimarg.in/images/og-image.jpg",
  keywords,
  canonical,
  jsonLd,
  breadcrumbs
} = Astro.props;

// Auto-generate BreadcrumbList JSON-LD from the breadcrumbs prop
const breadcrumbJsonLd = breadcrumbs && breadcrumbs.length > 0
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": breadcrumbs.map((item, index) => ({
        "@type": "ListItem",
        "position": index + 1,
        "name": item.name,
        "item": item.url
      }))
    }
  : null;
// Handle i18n URL generation
const currentPath = Astro.url.pathname;
const isEn = Astro.currentLocale === 'en';
const localeFreePath = isEn ? currentPath.replace(/^\/en/, '') : currentPath;
const mrPath = localeFreePath || '/';
const enPath = `/en${localeFreePath === '/' ? '' : localeFreePath}`;

const mrUrl = new URL(mrPath, Astro.site || 'https://mahitimarg.in');
const enUrl = new URL(enPath, Astro.site || 'https://mahitimarg.in');
---
<!DOCTYPE html>
<html lang={Astro.currentLocale || "mr"}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="google-site-verification" content="TrtPBuQPM6VTCty_ryr4V6kj4GDO9Ki-35vr_alygxg" />

    <!-- ✅ DNS PreConnect: saves ~300ms per page load -->
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com">
    <link rel="preconnect" href="https://www.googletagmanager.com">
    <link rel="dns-prefetch" href="https://www.googletagmanager.com">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <!-- ✅ Font Preload: improves LCP by loading Mukta font early -->
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Mukta:wght@400;600;700;800&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Mukta:wght@400;600;700;800&display=swap"></noscript>

    <!-- ✅ Geo & Author Meta: signals Maharashtra regional relevance to Google & Bing -->
    <meta name="author" content="MahitiMarg">
    <meta name="geo.region" content="IN-MH">
    <meta name="geo.placename" content="Maharashtra, India">
    <meta name="DC.language" content="mr">

    <ClientRouter />
    <link rel="alternate" hreflang="mr" href={mrUrl.href} />
    <link rel="alternate" hreflang="en" href={enUrl.href} />
    <link rel="alternate" hreflang="x-default" href={mrUrl.href} />
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      openGraph={{
        basic: {
          title: title,
          type: "article",
          image: image,
        },
        optional: {
          locale: Astro.currentLocale === 'en' ? "en_IN" : "mr_IN",
          siteName: "MahitiMarg",
        }
      }}
      twitter={{
        creator: "@mahitimarg"
      }}
      extend={{
        link: [{ rel: "icon", href: "/favicon.svg", type: "image/svg+xml" }],
        meta: [
          { name: "twitter:image", content: image },
          { name: "twitter:title", content: title },
          { name: "twitter:description", content: description },
        ],
      }}
    />
    {keywords && <meta name="keywords" content={keywords} />}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {breadcrumbJsonLd && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />}

    
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"></noscript>
    <script src="/js/script.js" defer></script>

    <!-- Google tag (gtag.js) - Only load in production -->
    {import.meta.env.PROD && (
      <>
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-BEB9SJ3QXK"></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());

          gtag('config', 'G-BEB9SJ3QXK');
        </script>
      </>
    )}
</head>
<body>
    <Header />
    <slot />
    <Footer />
</body>
</html>
