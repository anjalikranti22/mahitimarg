---
import Layout from '../../../layouts/Layout.astro';

const breadcrumbs = [
  { name: 'Home', url: 'https://mahitimarg.in/en/' },
  { name: 'Training', url: 'https://mahitimarg.in/en/training/' },
];

const keywords = 'PMKVY training, skill development Maharashtra, free government training, vocational training scheme, digital literacy, agricultural training';

const trainings = [
  { icon: 'fa-laptop-code', label: 'Digital Literacy', color: 'bg-blue', desc: 'Computer, Internet and Digital Payment Training', link: null },
  { icon: 'fa-tractor', label: 'Agricultural Training', color: 'bg-green', desc: 'Modern farming, drip irrigation and organic farming training', link: null },
  { icon: 'fa-scissors', label: 'Skill Development (PMKVY)', color: 'bg-orange', desc: 'Free govt training – tailoring, electrical, plumbing', link: '/en/jobs/skills' },
  { icon: 'fa-store', label: 'Entrepreneurship Training', color: 'bg-purple', desc: 'Expert guidance for starting your own business', link: null },
  { icon: 'fa-chart-line', label: 'Financial Literacy', color: 'bg-yellow', desc: 'Simple knowledge of savings, investment and banking', link: '/en/learn' },
  { icon: 'fa-person-dress', label: 'Women Entrepreneurship Training', color: 'bg-pink', desc: 'SHG, Self-Help Groups and women entrepreneurship', link: null },
];
---

<Layout
  title="Training – Free Government Skill Development | MahitiMarg"
  description="Information about PMKVY and other free government training schemes. Get digital, agricultural, and entrepreneurship training."
  keywords={keywords}
  canonical="https://mahitimarg.in/en/training/"
  breadcrumbs={breadcrumbs}
>
  <main class="container py-12 max-w-5xl mx-auto min-h-[75vh]">
    <div class="mb-8 animate-on-load">
      <a href="/en" class="inline-flex items-center gap-2 text-primary font-medium hover:underline transition-colors">
        <i class="fa-solid fa-arrow-left"></i> Back to Home
      </a>
    </div>

    <!-- Header -->
    <div class="glass-panel animate-on-load mb-10 text-center" style="padding: 3rem 2rem; border-top: 4px solid var(--primary);">
      <div style="font-size: 3.5rem; margin-bottom: 1rem;"><i class="fa-solid fa-graduation-cap" style="color: var(--primary);"></i></div>
      <h1 class="title-gradient" style="font-size: 2.5rem; margin-bottom: 0.75rem;">Training</h1>
      <p style="font-size: 1.1rem; color: var(--text-muted); max-width: 600px; margin: 0 auto;">Get free government skill development training and give a new direction to your career. PMKVY, Digital India and much more.</p>
    </div>

    <!-- Training Grid -->
    <div class="schemes-grid animate-on-scroll" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem;">
      {trainings.map((t) => (
        <a href={t.link ?? '#'} class="glass-panel" style={`padding: 2rem; text-align: center; border-radius: 16px; text-decoration: none; display: block; transition: transform 0.3s ease, box-shadow 0.3s ease; position: relative; overflow: hidden; ${!t.link ? 'pointer-events: none; opacity: 0.85;' : ''}`}
          onmouseenter={t.link ? "this.style.transform='translateY(-6px)'; this.style.boxShadow='0 15px 40px rgba(0,0,0,0.1)'" : undefined}
          onmouseleave={t.link ? "this.style.transform=''; this.style.boxShadow=''" : undefined}
        >
          {!t.link && <span style="position: absolute; top: 1rem; right: 1rem; background: var(--accent); color: white; font-size: 0.65rem; font-weight: 700; padding: 3px 10px; border-radius: 999px;">Coming Soon</span>}
          <div class={`scheme-icon-bg ${t.color}`} style="width: 64px; height: 64px; border-radius: 18px; margin: 0 auto 1.25rem; display: flex; align-items: center; justify-content: center; font-size: 1.75rem;">
            <i class={`fa-solid ${t.icon}`}></i>
          </div>
          <h3 style="font-size: 1.1rem; margin-bottom: 0.5rem; color: var(--text-main);">{t.label}</h3>
          <p style="color: var(--text-muted); font-size: 0.9rem; margin: 0;">{t.desc}</p>
        </a>
      ))}
    </div>

    <!-- Ad Space -->
    <div class="animate-on-scroll" style="margin-top: 3rem; min-height: 250px; background: rgba(0,0,0,0.02); border: 2px dashed rgba(0,0,0,0.08); border-radius: 16px; display: flex; align-items: center; justify-content: center; color: var(--text-muted); font-size: 0.9rem;">
      <span><i class="fa-solid fa-ad" style="margin-right: 0.5rem;"></i> Ad Space</span>
    </div>
  </main>
</Layout>
