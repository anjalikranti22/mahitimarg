---
import Layout from '../../../layouts/Layout.astro';

const breadcrumbs = [
  { name: 'Home', url: 'https://mahitimarg.in/en/' },
  { name: 'Financial Literacy', url: 'https://mahitimarg.in/en/learn/' },
];

const keywords = 'financial literacy, how to save money, investment guide, bank account, mutual fund, SIP information, money management';

const topics = [
  { icon: 'fa-piggy-bank', label: 'How to Save Money?', color: 'bg-green', desc: 'Guidance on how much to save monthly and where to keep it.', comingSoon: true },
  { icon: 'fa-chart-line', label: 'Investment', color: 'bg-blue', desc: 'Understand SIP, Mutual Funds, FD in simple language.', comingSoon: true },
  { icon: 'fa-university', label: 'Banking Literacy', color: 'bg-purple', desc: 'Information about bank accounts, ATM, net banking and UPI.', comingSoon: true },
  { icon: 'fa-calculator', label: 'Tax Information', color: 'bg-orange', desc: 'Simple information about Income Tax, GST and filing ITR.', comingSoon: true },
  { icon: 'fa-shield-halved', label: 'Insurance', color: 'bg-yellow', desc: 'Life insurance, health insurance – what is necessary, what is not.', comingSoon: true },
  { icon: 'fa-hand-holding-rupee', label: 'Loan Management', color: 'bg-pink', desc: 'When to take a loan, how to check interest rate, EMI planning.', comingSoon: false, link: '/en/tools/emi-calculator' },
];
---

<Layout
  title="Financial Literacy – Easy Way to Learn About Money | MahitiMarg"
  description="Learn about savings, investment, banking, insurance and tax – all financial topics in simple language."
  keywords={keywords}
  canonical="https://mahitimarg.in/en/learn/"
  breadcrumbs={breadcrumbs}
>
  <main class="container py-12 max-w-5xl mx-auto min-h-[75vh]">
    <div class="mb-8 animate-on-load">
      <a href="/en" class="inline-flex items-center gap-2 text-primary font-medium hover:underline transition-colors">
        <i class="fa-solid fa-arrow-left"></i> Back to Home
      </a>
    </div>

    <!-- Header -->
    <div class="glass-panel animate-on-load mb-10 text-center" style="padding: 3rem 2rem; border-top: 4px solid var(--accent);">
      <div style="font-size: 3.5rem; margin-bottom: 1rem;"><i class="fa-solid fa-coins" style="color: var(--accent);"></i></div>
      <h1 class="title-gradient" style="font-size: 2.5rem; margin-bottom: 0.75rem;">Financial Literacy</h1>
      <p style="font-size: 1.1rem; color: var(--text-muted); max-width: 650px; margin: 0 auto;">Earning money, saving, investing and maintaining financial stability – learn all of this in simple language.</p>
    </div>

    <!-- Topics Grid -->
    <div class="schemes-grid animate-on-scroll" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem;">
      {topics.map((t) => (
        <a href={t.link ?? '#'} class="glass-panel"
          style={`padding: 2rem; text-align: center; border-radius: 16px; text-decoration: none; display: block; position: relative; overflow: hidden; transition: transform 0.3s ease, box-shadow 0.3s ease; ${t.comingSoon ? 'pointer-events: none; opacity: 0.85;' : ''}`}
          onmouseenter={!t.comingSoon ? "this.style.transform='translateY(-6px)'; this.style.boxShadow='0 15px 40px rgba(0,0,0,0.1)'" : undefined}
          onmouseleave={!t.comingSoon ? "this.style.transform=''; this.style.boxShadow=''" : undefined}
        >
          {t.comingSoon && <span style="position: absolute; top: 1rem; right: 1rem; background: var(--accent); color: white; font-size: 0.65rem; font-weight: 700; padding: 3px 10px; border-radius: 999px;">Coming Soon</span>}
          {!t.comingSoon && <span style="position: absolute; top: 1rem; right: 1rem; background: #10b981; color: white; font-size: 0.65rem; font-weight: 700; padding: 3px 10px; border-radius: 999px;">Available</span>}
          <div class={`scheme-icon-bg ${t.color}`} style="width: 64px; height: 64px; border-radius: 18px; margin: 0 auto 1.25rem; display: flex; align-items: center; justify-content: center; font-size: 1.75rem;">
            <i class={`fa-solid ${t.icon}`}></i>
          </div>
          <h3 style="font-size: 1.1rem; margin-bottom: 0.5rem; color: var(--text-main);">{t.label}</h3>
          <p style="color: var(--text-muted); font-size: 0.9rem; margin: 0;">{t.desc}</p>
        </a>
      ))}
    </div>

    <!-- Quick Tool CTA -->
    <div class="glass-panel animate-on-scroll" style="margin-top: 3rem; padding: 2.5rem; text-align: center; border-top: 4px solid var(--primary); border-radius: 16px;">
      <h2 style="font-size: 1.5rem; margin-bottom: 0.75rem;">🧮 Use Now – EMI Calculator</h2>
      <p style="color: var(--text-muted); margin-bottom: 1.5rem;">Before taking a loan, check exactly what your installment will be.</p>
      <a href="/en/tools/emi-calculator" class="btn btn-primary ripple-effect">
        <i class="fa-solid fa-calculator"></i> Calculate EMI
      </a>
    </div>

    <!-- Ad Space -->
    <div class="animate-on-scroll" style="margin-top: 3rem; min-height: 250px; background: rgba(0,0,0,0.02); border: 2px dashed rgba(0,0,0,0.08); border-radius: 16px; display: flex; align-items: center; justify-content: center; color: var(--text-muted); font-size: 0.9rem;">
      <span><i class="fa-solid fa-ad" style="margin-right: 0.5rem;"></i> Ad Space</span>
    </div>
  </main>
</Layout>
