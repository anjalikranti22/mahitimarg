---
import Layout from '../../../layouts/Layout.astro';

const breadcrumbs = [
  { name: 'Home', url: 'https://mahitimarg.in/en/' },
  { name: 'Government Services', url: 'https://mahitimarg.in/en/services/' },
];

const keywords = 'government services Maharashtra, online government services, Aadhaar registration, ration card online, birth certificate, caste certificate, MahaOnline portal';

const services = [
  { icon: 'fa-id-card', label: 'Aadhaar Services', color: 'bg-blue', desc: 'Aadhaar registration, update, download', link: 'https://myaadhaar.uidai.gov.in/', external: true },
  { icon: 'fa-wheat-awn', label: 'Ration Card', color: 'bg-green', desc: 'New ration card, check beneficiary list', link: 'https://rcms.mahafood.gov.in/', external: true },
  { icon: 'fa-baby', label: 'Birth / Death Certificate', color: 'bg-orange', desc: 'Birth-death certificate online', link: 'https://aaplesarkar.mahaonline.gov.in/', external: true },
  { icon: 'fa-passport', label: 'Passport Services', color: 'bg-purple', desc: 'Passport application and appointment', link: 'https://passportindia.gov.in/', external: true },
  { icon: 'fa-user-shield', label: 'Caste Certificate', color: 'bg-yellow', desc: 'SC/ST/OBC caste certificate', link: 'https://aaplesarkar.mahaonline.gov.in/', external: true },
  { icon: 'fa-building-columns', label: 'MahaOnline Portal', color: 'bg-pink', desc: 'All Maharashtra online services', link: 'https://mahaonline.gov.in/', external: true },
  { icon: 'fa-car', label: 'Vehicle RC / Driving Licence', color: 'bg-blue', desc: 'RTO vehicle registration and licence', link: 'https://parivahan.gov.in/', external: true },
  { icon: 'fa-file-invoice', label: 'Income Certificate', color: 'bg-green', desc: 'Income / domicile certificate', link: 'https://aaplesarkar.mahaonline.gov.in/', external: true },
];
---

<Layout
  title="Government Services Online | MahitiMarg"
  description="Aadhaar, Ration Card, Birth Certificate, Caste Certificate, and all Maharashtra online government services in one place."
  keywords={keywords}
  canonical="https://mahitimarg.in/en/services/"
  breadcrumbs={breadcrumbs}
>
  <main class="container py-12 max-w-5xl mx-auto min-h-[75vh]">
    <div class="mb-8 animate-on-load">
      <a href="/en" class="inline-flex items-center gap-2 text-primary font-medium hover:underline transition-colors">
        <i class="fa-solid fa-arrow-left"></i> Back to Home
      </a>
    </div>

    <div class="glass-panel animate-on-load mb-10 text-center" style="padding: 3rem 2rem; border-top: 4px solid var(--primary);">
      <div style="font-size: 3.5rem; margin-bottom: 1rem;"><i class="fa-solid fa-landmark" style="color: var(--primary);"></i></div>
      <h1 class="title-gradient" style="font-size: 2.5rem; margin-bottom: 0.75rem;">Government Services</h1>
      <p style="font-size: 1.1rem; color: var(--text-muted); max-width: 600px; margin: 0 auto;">Direct links to all important government services of Maharashtra – apply online from home.</p>
    </div>

    <div class="schemes-grid animate-on-scroll" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1.5rem;">
      {services.map((s) => (
        <a href={s.link} target={s.external ? '_blank' : '_self'} rel={s.external ? 'noopener noreferrer' : undefined}
          class="glass-panel"
          style="padding: 2rem; text-align: center; border-radius: 16px; text-decoration: none; display: block; transition: transform 0.3s ease, box-shadow 0.3s ease;"
          onmouseenter="this.style.transform='translateY(-6px)'; this.style.boxShadow='0 15px 40px rgba(0,0,0,0.1)'"
          onmouseleave="this.style.transform=''; this.style.boxShadow=''"
        >
          <div class={`scheme-icon-bg ${s.color}`} style="width: 64px; height: 64px; border-radius: 18px; margin: 0 auto 1.25rem; display: flex; align-items: center; justify-content: center; font-size: 1.75rem;">
            <i class={`fa-solid ${s.icon}`}></i>
          </div>
          <h3 style="font-size: 1rem; margin-bottom: 0.5rem; color: var(--text-main);">{s.label}</h3>
          <p style="color: var(--text-muted); font-size: 0.85rem; margin: 0 0 1rem 0;">{s.desc}</p>
          {s.external && <span style="font-size: 0.75rem; color: var(--primary); font-weight: 600;"><i class="fa-solid fa-arrow-up-right-from-square" style="margin-right: 4px;"></i> Official Portal</span>}
        </a>
      ))}
    </div>

    <p class="animate-on-scroll" style="text-align: center; margin-top: 3rem; color: var(--text-muted); font-size: 0.9rem;">
      <i class="fa-solid fa-circle-info" style="margin-right: 0.5rem;"></i>
      All external links above lead to official government websites. MahitiMarg only provides guidance.
    </p>

    <div class="animate-on-scroll" style="margin-top: 2rem; min-height: 250px; background: rgba(0,0,0,0.02); border: 2px dashed rgba(0,0,0,0.08); border-radius: 16px; display: flex; align-items: center; justify-content: center; color: var(--text-muted); font-size: 0.9rem;">
      <span><i class="fa-solid fa-ad" style="margin-right: 0.5rem;"></i> Ad Space</span>
    </div>
  </main>
</Layout>
