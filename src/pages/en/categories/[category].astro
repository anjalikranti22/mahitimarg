---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import SchemeCard from '../../../components/SchemeCard.astro';

export async function getStaticPaths() {
  function getMarathiKeyword(slug: string) {
      switch(slug) {
          case 'farmer': return 'शेतकरी';
          case 'women': return 'महिला';
          case 'business': return 'व्यवसाय';
          case 'student': return 'विद्यार्थी';
          default: return '';
      }
  }

  const categories = [
    { slug: 'farmer', name: 'Farmer Schemes', badgeKeyword: 'Farmer' },
    { slug: 'women', name: 'Women\'s Schemes', badgeKeyword: 'Women' },
    { slug: 'business', name: 'Business Schemes', badgeKeyword: 'Business' },
    { slug: 'student', name: 'Student Schemes', badgeKeyword: 'Student' },
  ];

  const allSchemes = await getCollection('schemes-en');

  return categories.map(category => {
    const filteredSchemes = allSchemes.filter(scheme => 
      scheme.data.badge.toLowerCase().includes(category.badgeKeyword.toLowerCase()) || 
      scheme.data.badge.toLowerCase().includes(getMarathiKeyword(category.slug))
    );

    return {
      params: { category: category.slug },
      props: { categoryName: category.name, schemes: filteredSchemes },
    };
  });
}

const { categoryName, schemes } = Astro.props;
---

<Layout title={`${categoryName} | MahitiMarg 2026`} description={`Find all government schemes for ${categoryName.toLowerCase()} in Maharashtra.`}>
    <!-- Category Header -->
    <section class="category-header bg-gradient-primary text-white text-center py-5" style="padding: 3rem 1rem; background: linear-gradient(135deg, var(--primary-color), var(--accent-color));">
        <div class="container">
            <h1 class="display-4 font-weight-bold" style="color: white; margin-bottom: 0.5rem; font-size: 2.5rem;"><i class="fa-solid fa-list" aria-hidden="true"></i> {categoryName}</h1>
            <p class="lead" style="color: rgba(255,255,255,0.9); font-size: 1.1rem;">Explore all available schemes under this category.</p>
        </div>
    </section>

    <!-- Schemes Grid -->
    <main class="container py-5" style="padding: 4rem 1rem;">
        {schemes.length > 0 ? (
            <div class="schemes-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem;">
                {schemes.map((scheme) => (
                    <SchemeCard scheme={scheme} lang="en" />
                ))}
            </div>
        ) : (
            <div class="no-results-msg" style="text-align: center; padding: 3rem; background: rgba(0,0,0,0.02); border-radius: 12px; border: 1px dashed rgba(0,0,0,0.1);">
                 <i class="fa-solid fa-folder-open" aria-hidden="true" style="font-size: 3rem; color: var(--text-muted); margin-bottom: 1rem;"></i>
                <h3 style="color: var(--text-muted); font-size: 1.5rem; margin-bottom: 0.5rem;">No schemes found</h3>
                <p style="color: var(--text-muted);">Currently no schemes are available in this category. Please check back later.</p>
                <a href="/en" class="btn btn-primary mt-2 ripple-effect"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Back to Home</a>
            </div>
        )}
    </main>
</Layout>
