---
import Layout from '../../../layouts/Layout.astro';

const businessData = [
  {
    id: "startup-guide",
    title: "How to Start a New Business?",
    description: "A complete step-by-step guide to starting your own business.",
    icon: "fa-solid fa-rocket",
    link: "/en/business/startup-guide",
  },
  {
    id: "registration",
    title: "Required Licenses & Registration",
    description: "How to register Udyam Aadhaar (MSME) and Shop Act License.",
    icon: "fa-solid fa-file-signature",
    link: "/en/business/registration",
  },
  {
    id: "business-loans",
    title: "Business Loan Schemes",
    description: "MUDRA Loan, PMEGP, and Annasaheb Patil Corporation Loans.",
    icon: "fa-solid fa-hand-holding-dollar",
    link: "/en/business/loans",
  },
  {
    id: "pm-vishwakarma",
    title: "PM Vishwakarma Yojana",
    description: "Financial assistance and training for traditional artisans.",
    icon: "fa-solid fa-hammer",
    link: "/en/business/pm-vishwakarma",
  }
];
---

<Layout title="Business Guide | MahitiMarg">
    <main>
        <section class="hero" aria-labelledby="business-hero-title">
            <div class="hero-bg-accent"></div>
            <div class="container glass-panel hero-glass animate-on-load" style="padding: 3rem 2rem; text-align: center;">
                <div style="font-size: 3rem; color: var(--primary); margin-bottom: 1rem;">
                    <i class="fa-solid fa-briefcase"></i>
                </div>
                <h1 id="business-hero-title" class="title-gradient">Business Hub</h1>
                <p class="hero-description" style="max-width: 700px; margin: 0 auto;">
                    Schemes, loans, and step-by-step guidance to start and grow your business.
                </p>
            </div>
        </section>

        <section class="container scheme-category-section" style="padding-top: 2rem; padding-bottom: 4rem;">
            <div class="section-header animate-on-scroll">
                <h2>Business Categories</h2>
                <p>Select your preferred section below</p>
            </div>
            
            <div class="schemes-grid animate-on-scroll" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;">
                {businessData.map((biz) => (
                    <a href={biz.link} class="glass-panel" style={`
                        display: flex; 
                        flex-direction: column; 
                        padding: 2.5rem 2rem; 
                        text-decoration: none; 
                        border: 1px solid rgba(255,255,255,0.2); 
                        border-top: 4px solid var(--accent);
                        border-radius: 16px; 
                        background: rgba(255, 255, 255, 0.85);
                        backdrop-filter: blur(12px);
                        transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.3s ease;
                    `}
                    onmouseenter="this.style.transform='scale(1.03)'; this.style.boxShadow='0 15px 30px -5px rgba(0, 0, 0, 0.1)'"
                    onmouseleave="this.style.transform='scale(1)'; this.style.boxShadow='none'"
                    >
                        <div style="font-size: 2.5rem; color: var(--primary); margin-bottom: 1.5rem;">
                            <i class={biz.icon || "fa-solid fa-circle-right"}></i>
                        </div>
                        <h3 style="font-size: 1.4rem; font-weight: 700; color: var(--text-dark); margin-bottom: 0.75rem; font-family: 'Mukta', sans-serif;">
                            {biz.title}
                        </h3>
                        <p style="color: var(--text-main); font-size: 1.05rem; line-height: 1.6; margin-bottom: 1.5rem; flex-grow: 1;">
                            {biz.description}
                        </p>
                        <div style="color: var(--primary-color); font-weight: 600; display: flex; align-items: center; gap: 0.5rem; margin-top: auto; font-size: 0.95rem;">
                            Read More <i class="fa-solid fa-arrow-right"></i>
                        </div>
                    </a>
                ))}
            </div>
        </section>
    </main>
</Layout>
