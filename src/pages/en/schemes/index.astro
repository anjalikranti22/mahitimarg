---
import Layout from '../../../layouts/Layout.astro';
import SchemeCard from '../../../components/SchemeCard.astro';
import { getCollection } from 'astro:content';

const allSchemes = await getCollection('schemes');

const schemesBreadcrumbs = [
  { name: 'Home', url: 'https://mahitimarg.in/en/' },
  { name: 'All Schemes', url: 'https://mahitimarg.in/en/schemes/' },
];

const schemesKeywords = 'all government schemes Maharashtra, सर्व सरकारी योजना, Maharashtra government schemes 2025, farmer schemes, women schemes, student schemes, business schemes, central government schemes Marathi, mahitimarg yojana';
---

<Layout
  title="All Government Schemes | MahitiMarg"
  description="Find all Maharashtra and Central Government schemes in one place. Schemes for farmers, women, students, and businesses."
  keywords={schemesKeywords}
  canonical="https://mahitimarg.in/en/schemes/"
  breadcrumbs={schemesBreadcrumbs}
>
    <section class="category-header bg-gradient-primary text-white text-center py-5" style="padding: 3rem 1rem; background: linear-gradient(135deg, var(--primary-color), var(--accent-color));">
        <div class="container">
            <h1 class="display-4 font-weight-bold" style="color: white; margin-bottom: 0.5rem; font-size: 2.5rem;"><i class="fa-solid fa-th-list" aria-hidden="true"></i> All Schemes</h1>
            <p class="lead" style="color: rgba(255,255,255,0.9); font-size: 1.1rem;">Find all Central and State Government schemes in one place.</p>
        </div>
    </section>

    <!-- Schemes Grid -->
    <main class="container py-5" style="padding: 4rem 1rem;">
        <div class="search-container mb-8" style="max-width: 600px; margin: 0 auto 3rem auto; position: relative;">
            <i class="fa-solid fa-search search-icon" aria-hidden="true" style="position: absolute; left: 1.5rem; top: 50%; transform: translateY(-50%); color: var(--text-muted);"></i>
            <input type="text" id="scheme-search-page" class="search-input" style="width: 100%; padding: 1rem 1rem 1rem 3.5rem; border-radius: 50px; border: 2px solid rgba(0,0,0,0.1);" placeholder="Search schemes... (e.g. Farmer, Loan)" aria-label="Search schemes">
        </div>

        {allSchemes.length > 0 ? (
            <div class="schemes-grid" id="all-schemes-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem;">
                {allSchemes.map((scheme) => (
                    <div class="scheme-item" data-title={scheme.data.title.toLowerCase()} data-badge={scheme.data.badge.toLowerCase()} data-desc={scheme.data.description.toLowerCase()}>
                        <SchemeCard scheme={scheme} lang="en" />
                    </div>
                ))}
            </div>
        ) : (
            <div class="no-results-msg" style="text-align: center; padding: 3rem; background: rgba(0,0,0,0.02); border-radius: 12px; border: 1px dashed rgba(0,0,0,0.1);">
                 <i class="fa-solid fa-folder-open" aria-hidden="true" style="font-size: 3rem; color: var(--text-muted); margin-bottom: 1rem;"></i>
                <h3 style="color: var(--text-muted); font-size: 1.5rem; margin-bottom: 0.5rem;">No schemes found</h3>
            </div>
        )}
        <div id="no-results-search" class="hidden" style="text-align: center; padding: 3rem;">
            <i class="fa-solid fa-search-minus" style="font-size: 3rem; color: var(--text-muted); margin-bottom: 1rem;"></i>
            <h3 style="color: var(--text-muted); font-size: 1.5rem;">No schemes found for your search</h3>
        </div>
    </main>

    <script>
        document.addEventListener('astro:page-load', () => {
        const searchInput = document.getElementById('scheme-search-page');
        const schemeItems = document.querySelectorAll('.scheme-item');
        const noResults = document.getElementById('no-results-search');

        if (searchInput) {
            searchInput.addEventListener('input', (e) => {
                const term = e.target.value.toLowerCase();
                let visibleCount = 0;

                schemeItems.forEach(item => {
                    const title = item.getAttribute('data-title');
                    const badge = item.getAttribute('data-badge');
                    const desc = item.getAttribute('data-desc');

                    if (title.includes(term) || badge.includes(term) || desc.includes(term)) {
                        item.style.display = 'block';
                        visibleCount++;
                    } else {
                        item.style.display = 'none';
                    }
                });

                if (noResults) {
                    noResults.style.display = visibleCount === 0 ? 'block' : 'none';
                }
            });
        }
        });
    </script>
</Layout>
