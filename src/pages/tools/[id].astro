---
import Layout from '../../layouts/Layout.astro';
import EmiCalculator from '../../components/tools/EmiCalculator.astro';
import AgeCalculator from '../../components/tools/AgeCalculator.astro';

export function getStaticPaths() {
  const toolPages = [
    {
      id: 'emi-calculator',
      title: 'EMI कॅल्क्युलेटर',
      description: 'गृहकर्ज, वाहन कर्ज किंवा वैयक्तिक कर्जाचा मासिक हप्ता (EMI) मोफत ऑनलाईन काढा. व्याजदर, कालावधी आणि व्याज तक्ता सह.',
      keywords: 'EMI calculator Marathi, कर्ज हप्ता कॅल्क्युलेटर, home loan EMI, मासिक हप्ता, व्याजदर, गृहकर्ज, वाहन कर्ज EMI, loan calculator Maharashtra',
    },
    {
      id: 'eligibility-checker',
      title: 'पात्रता चेकर (Eligibility)',
      description: 'तुम्ही कोणत्या सरकारी योजनेसाठी पात्र आहात हे जाणून घ्या. मोफत ऑनलाईन पात्रता तपासणी.',
      keywords: 'government scheme eligibility, सरकारी योजना पात्रता, सरकारी योजना कोणाला मिळते, sheti yojana eligibility, महाराष्ट्र सरकारी योजना 2025',
    },
    {
      id: 'age-calculator',
      title: 'वय कॅल्क्युलेटर',
      description: 'तुमचे अचूक वय वर्षे, महिने आणि दिवसांत काढा. सरकारी योजना, नोकरी अर्ज, आणि शिष्यवृत्तीसाठी उपयुक्त.',
      keywords: 'age calculator Marathi, वय कॅल्क्युलेटर, वय किती आहे, age in years months days, date of birth calculator, जन्मतारीख वय',
    }
  ];

  return toolPages.map(page => ({
    params: { id: page.id },
    props: { page },
  }));
}

const { page } = Astro.props;

const breadcrumbs = [
  { name: 'मुख्यपृष्ठ', url: 'https://mahitimarg.in/' },
  { name: 'स्मार्ट टूल्स', url: 'https://mahitimarg.in/tools/' },
  { name: page.title, url: `https://mahitimarg.in/tools/${page.id}/` },
];
---

<Layout
  title={`${page.title} | MahitiMarg`}
  description={page.description}
  keywords={page.keywords}
  canonical={`https://mahitimarg.in/tools/${page.id}/`}
  breadcrumbs={breadcrumbs}
>
    <main class="container py-8 max-w-4xl mx-auto" style="min-height: 80vh;">
        <div class="mb-6 animate-on-load">
            <a href="/tools" class="inline-flex items-center gap-2 text-primary font-medium hover:underline transition-colors" style="font-family: 'Mukta', sans-serif;">
                <i class="fa-solid fa-arrow-left"></i> स्मार्ट टूल्स (Smart Tools Hub)
            </a>
        </div>
        <article class="glass-panel animate-on-scroll shadow-md" style="padding: 3rem; border-radius: 16px; background: rgba(255, 255, 255, 0.95); border-top: 4px solid var(--accent);">
            <header style="margin-bottom: 2rem; border-bottom: 1px solid rgba(0,0,0,0.1); padding-bottom: 1.5rem;">
                <h1 class="title-gradient" style="font-size: 2.2rem; margin-bottom: 0.5rem; font-family: 'Mukta', sans-serif;">{page.title}</h1>
            </header>
            
            <div class="article-content scheme-detail" style="font-family: 'Mukta', sans-serif;">
                {page.id === 'emi-calculator' && <EmiCalculator />}
                {page.id === 'age-calculator' && <AgeCalculator />}
                {page.id === 'eligibility-checker' && (
                  <div>
                    <h2 class="text-2xl font-bold text-slate-800 mb-2">तुम्ही कोणत्या सरकारी योजनेसाठी पात्र आहात?</h2>
                    <p class="mb-8 text-slate-600">लवकरच येत आहे...</p>
                    <div class="w-full min-h-[250px] bg-slate-50 border-2 border-dashed border-slate-200 rounded-xl flex items-center justify-center mb-8 text-slate-400 text-sm">
                      जाहीरात (Ad Space)
                    </div>
                  </div>
                )}
            </div>
            
        </article>
    </main>
</Layout>
