        <div id="no-results-msg" class="container no-results-msg hidden" style="text-align: center; padding: 2rem;">
            <i class="fa-solid fa-search-minus" aria-hidden="true"
                style="font-size: 3rem; color: var(--text-muted); margin-bottom: 1rem;"></i>
            <p style="font-size: 1.2rem; font-weight: 500;">कोणतीही योजना सापडली नाही.</p>
            <button class="btn btn-secondary mt-2" id="clear-search-btn">Clear Search</button>
        </div>
    </main>
</Layout>


<script>
document.addEventListener('astro:page-load', () => {
// ============================================================
// LIVE SEARCH ENGINE – MahitiMarg Homepage
// ============================================================

const schemeDataEl = document.getElementById('scheme-data');
const SCHEMES = schemeDataEl ? JSON.parse(schemeDataEl.textContent) : [];

// Bento card keyword mapping (order matches DOM order of .hp-bento__card)
const BENTO_DATA = [
  { terms: ['योजना','scheme','yojana','sarkari','सरकार','farmer','शेतकरी','women','महिला','student','विद्यार्थी','सरकारी'], href: '/schemes' },
  { terms: ['job','नोकरी','रोजगार','mpsc','career','भरती','rojgar'], href: '/jobs' },
  { terms: ['service','सेवा','aadhar','आधार','ration','रेशन','दाखले'], href: '/services' },
  { terms: ['training','प्रशिक्षण','pmkvy','skill','कौशल्य'], href: '/training' },
  { terms: ['article','लेख','news','बातमी'], href: '/articles' },
  { terms: ['download','डाउनलोड','pdf','form','अर्ज'], href: '/downloads' },
  { terms: ['learn','अर्थ','finance','emi','बचत','गुंतवणूक','कर्ज','loan','savings'], href: '/learn' },
  { terms: ['tool','टूल','calculator','कॅल्क्युलेटर','emi','fd','rd','age','वय'], href: '/tools' },
];

const bentoCards = [...document.querySelectorAll('.hp-bento__card')];
const input        = document.getElementById('scheme-search');
const dropdown     = document.getElementById('search-dropdown');
const dropInner    = document.getElementById('search-dropdown-inner');
const dropEmpty    = document.getElementById('search-dropdown-empty');
const clearBtn     = document.getElementById('search-clear-btn');

function norm(s) { return (s||'').toLowerCase(); }

function highlight(text, q) {
  if (!q) return text;
  const safe = q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  return text.replace(new RegExp('('+safe+')', 'gi'), '<mark class="hp-mark">$1</mark>');
}

// Filter bento tiles
function filterBento(q) {
  bentoCards.forEach((card, i) => {
    const data = BENTO_DATA[i];
    if (!data) { card.style.opacity = '1'; return; }
    const matches = !q || data.terms.some(t => norm(t).includes(q) || q.includes(norm(t)));
    card.style.transition = 'all 0.3s ease';
    card.style.opacity    = matches ? '1' : '0.22';
    card.style.transform  = matches ? (q ? 'scale(1.02) translateY(-3px)' : '') : 'scale(0.96)';
    card.style.pointerEvents = matches ? '' : 'none';
  });
}

// Filter category chips
function filterChips(q) {
  document.querySelectorAll('.category-chip').forEach(chip => {
    const matches = !q || norm(chip.textContent).includes(q);
    chip.style.transition = 'all 0.25s ease';
    chip.style.opacity    = matches ? '1' : '0.2';
    chip.style.transform  = matches ? '' : 'scale(0.93)';
  });
}

// Build dropdown HTML
function renderDropdown(q) {
  if (!q || q.length < 2) { dropdown.style.display = 'none'; return; }

  const matched = SCHEMES.filter(s =>
    norm(s.title+' '+s.category+' '+s.description).includes(q)
  ).slice(0, 7);

  const bentoMatches = BENTO_DATA.filter(b =>
    b.terms.some(t => norm(t).includes(q) || q.includes(norm(t)))
  );

  if (matched.length === 0 && bentoMatches.length === 0) {
    dropInner.innerHTML = '';
    dropEmpty.style.display = 'flex';
    dropdown.style.display = 'block';
    return;
  }

  dropEmpty.style.display = 'none';
  let html = '';

  if (bentoMatches.length) {
    html += '<div class="hp-sdrop-group">विभाग (Sections)</div>';
    bentoMatches.forEach(b => {
      const card = bentoCards[BENTO_DATA.indexOf(b)];
      const title = card ? (card.querySelector('.hp-bento__title')?.textContent || b.href) : b.href;
      html += `<a href="${b.href}" class="hp-sdrop-item hp-sdrop-item--section">
        <i class="fa-solid fa-compass"></i>
        <span>${highlight(title, q)}</span>
        <span class="hp-sdrop-meta">${b.href}</span>
      </a>`;
    });
  }

  if (matched.length) {
    html += '<div class="hp-sdrop-group">योजना (Schemes)</div>';
    matched.forEach(s => {
      const cat = s.category ? `<span class="hp-sdrop-cat">${s.category}</span>` : '';
      html += `<a href="/schemes/${s.slug}" class="hp-sdrop-item">
        <i class="fa-solid fa-file-lines"></i>
        <span>${highlight(s.title, q)}</span>
        ${cat}
      </a>`;
    });
  }

  html += `<div class="hp-sdrop-footer">
    <a href="/schemes?q=${encodeURIComponent(q)}">सर्व परिणाम पहा <i class="fa-solid fa-arrow-right"></i></a>
  </div>`;

  dropInner.innerHTML = html;
  dropdown.style.display = 'block';
}

function doSearch() {
  const q = norm(input.value.trim());
  clearBtn.style.display = q ? 'flex' : 'none';
  renderDropdown(q);
  filterBento(q);
  filterChips(q);
}

function clearSearch() {
  input.value = '';
  clearBtn.style.display = 'none';
  dropdown.style.display = 'none';
  filterBento('');
  filterChips('');
}

if (input) {
  input.addEventListener('input', doSearch);
  input.addEventListener('keydown', e => { if (e.key === 'Escape') clearSearch(); });
  input.addEventListener('focus', () => { if (input.value.trim().length >= 2) dropdown.style.display = 'block'; });
}
if (clearBtn) clearBtn.addEventListener('click', clearSearch);

document.addEventListener('click', e => {
  if (!e.target.closest('.hp-search-wrap')) dropdown.style.display = 'none';
});

// ---- Counter animation ----
function animateCounters() {
  document.querySelectorAll('.stat-number').forEach(counter => {
    const target = parseInt(counter.getAttribute('data-target'));
    const startTime = performance.now();
    (function update(now) {
      const p = Math.min((now - startTime) / 2000, 1);
      const v = Math.floor((1 - Math.pow(1-p,3)) * target);
      counter.textContent = target >= 1000 ? v.toLocaleString('en-IN') : v;
      if (p < 1) requestAnimationFrame(update);
    })(startTime);
  });
}

const statsSec = document.getElementById('trust-stats');
if (statsSec) {
  new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) { animateCounters(); } });
  }, { threshold: 0.3 }).observe(statsSec);
}

// Search tab switching
document.querySelectorAll('.search-tab').forEach(tab => {
  tab.addEventListener('click', () => {
    document.querySelectorAll('.search-tab').forEach(t => t.classList.remove('active'));
    tab.classList.add('active');
  });
});
});
</script>

