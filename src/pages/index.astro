---
import Layout from '../layouts/Layout.astro';
import SchemeCard from '../components/SchemeCard.astro';
import { getCollection } from 'astro:content';

// Fetch all schemes from the Content Collection
const allSchemes = await getCollection('schemes');
const featuredSchemes = allSchemes.slice(0, 6);
const totalSchemes = allSchemes.length;

// Build search data for live search
const schemeSearchData = allSchemes.map(s => ({
  title: s.data.title || '',
  category: s.data.category || '',
  description: (s.data.description || '').slice(0, 120),
  slug: s.slug,
}));
---

<Layout 
    title="MahitiMarg | योजना · रोजगार · व्यवसाय · टूल्स – सर्व माहिती एकाच ठिकाणी"
    canonical="https://mahitimarg.in/"
>
    <script type="application/json" id="scheme-data" set:html={JSON.stringify(schemeSearchData)}></script>
    <main>
        <!-- Section 1: Hero + Universal Search -->
        <section class="hp-hero" aria-labelledby="hero-title">
            <div class="hp-hero__bg" aria-hidden="true">
                <div class="hp-hero__blob hp-hero__blob--1"></div>
                <div class="hp-hero__blob hp-hero__blob--2"></div>
                <div class="hp-hero__ring hp-hero__ring--1"></div>
                <div class="hp-hero__ring hp-hero__ring--2"></div>
            </div>

            <div class="container hp-hero__inner animate-on-load">
                <span class="hp-badge">
                    <i class="fa-solid fa-info-circle" aria-hidden="true"></i> माहितीचा नवा मार्ग
                </span>
                <h1 id="hero-title" class="hp-hero__title">
                    योजना <span class="hp-dot">·</span> रोजगार <span class="hp-dot">·</span> व्यवसाय <span class="hp-dot">·</span> टूल्स
                </h1>
                <p class="hp-hero__sub">
                    सर्व महाराष्ट्र राज्य आणि केंद्र सरकारच्या योजना, रोजगार माहिती आणि उपयुक्त टूल्स – साध्या मराठीत, एकाच ठिकाणी.
                </p>

                <!-- Search -->
                <div class="hp-search-wrap">
                    <div class="hp-search-glow" aria-hidden="true"></div>
                    <div class="hp-search-box">
                        <i class="fa-solid fa-search hp-search-icon" aria-hidden="true"></i>
                        <input type="text" id="scheme-search" class="hp-search-input"
                            placeholder="योजना शोधा... (उदा. शेतकरी, महिला, EMI, लाडकी)"
                            aria-label="Search schemes"
                            autocomplete="off">
                        <button id="search-clear-btn" class="hp-search-clear" aria-label="Clear search" style="display:none;">
                            <i class="fa-solid fa-times"></i>
                        </button>
                        <button class="btn btn-primary hp-search-btn ripple-effect" aria-label="Submit search">शोधा</button>
                    </div>
                    <div id="search-dropdown" class="hp-search-dropdown" role="listbox" style="display:none;">
                        <div id="search-dropdown-inner"></div>
                        <div id="search-dropdown-empty" class="hp-search-empty" style="display:none;">
                            <i class="fa-solid fa-magnifying-glass"></i>
                            <span>कोणतीही योजना सापडली नाही</span>
                        </div>
                    </div>
                </div>

                <!-- Search Tabs -->
                <div class="search-tabs" id="search-tabs" style="margin-top: 1.25rem;">
                    <button class="search-tab active" data-tab="all"><i class="fa-solid fa-magnifying-glass"></i> सर्व</button>
                    <button class="search-tab" data-tab="schemes"><i class="fa-solid fa-file-lines"></i> योजना</button>
                    <button class="search-tab" data-tab="articles"><i class="fa-solid fa-newspaper"></i> लेख</button>
                    <button class="search-tab" data-tab="tools"><i class="fa-solid fa-wrench"></i> टूल्स</button>
                </div>

                <!-- Quick Category Links -->
                <div class="hp-quick-links">
                    <a href="/categories/farmer" class="hp-qlink"><i class="fa-solid fa-tractor"></i> शेतकरी</a>
                    <a href="/categories/women" class="hp-qlink"><i class="fa-solid fa-person-dress"></i> महिला</a>
                    <a href="/categories/business" class="hp-qlink"><i class="fa-solid fa-briefcase"></i> व्यवसाय</a>
                    <a href="/categories/student" class="hp-qlink"><i class="fa-solid fa-graduation-cap"></i> विद्यार्थी</a>
                    <a href="/categories/pension" class="hp-qlink"><i class="fa-solid fa-piggy-bank"></i> पेन्शन</a>
                    <a href="/categories/health" class="hp-qlink"><i class="fa-solid fa-heart-pulse"></i> आरोग्य</a>
                    <a href="/schemes" class="hp-qlink hp-qlink--accent"><i class="fa-solid fa-arrow-right"></i> सर्व पहा</a>
                </div>

                <!-- Trust Stats -->
                <div class="hp-stats">
                    <div class="hp-stat"><span class="hp-stat__num">२००+</span><span class="hp-stat__label">सरकारी योजना</span></div>
                    <div class="hp-stat"><span class="hp-stat__num">१४+</span><span class="hp-stat__label">कॅटेगरी</span></div>
                    <div class="hp-stat"><span class="hp-stat__num">१०+</span><span class="hp-stat__label">स्मार्ट टूल्स</span></div>
                    <div class="hp-stat"><span class="hp-stat__num">५०,०००+</span><span class="hp-stat__label">मदत मिळालेले</span></div>
                </div>
            </div>
        </section>

        <!-- Section 2: Featured Schemes (Top 6 Only) -->
        <section id="popular-schemes" class="container scheme-category-section" aria-labelledby="popular-schemes-title">
            <div class="section-header animate-on-scroll">
                <div class="section-badge"><i class="fa-solid fa-star" aria-hidden="true"></i> Featured</div>
                <h2 id="popular-schemes-title">लोकप्रिय योजना (Featured Schemes)</h2>
                <p>सर्वात जास्त शोधल्या जाणाऱ्या आणि उपयुक्त सरकारी योजना</p>
            </div>
            <div class="schemes-grid" id="popular-schemes-list">
                {featuredSchemes.map((scheme) => (
                    <SchemeCard scheme={scheme} />
                ))}
            </div>
            <div class="view-all-cta animate-on-scroll">
                <a href="/schemes" class="btn btn-accent ripple-effect btn-view-all">
                    <i class="fa-solid fa-th-list"></i> सर्व {totalSchemes}+ योजना पहा
                    <i class="fa-solid fa-arrow-right arrow-icon"></i>
                </a>
            </div>
        </section>

        <!-- Section 2.5: Bento Gateway – Modern Redesign -->
        <section id="gateway-sections" class="hp-bento-section" aria-labelledby="gateway-title">
            <div class="container">
                <div class="section-header animate-on-scroll">
                    <div class="section-badge"><i class="fa-solid fa-compass" aria-hidden="true"></i> MahitiMarg</div>
                    <h2 id="gateway-title">आम्ही काय देतो? (What We Offer)</h2>
                    <p>तुमच्या विकासासाठी तुम्हाला लागणारी सर्व माहिती आणि सेवा एकाच ठिकाणी</p>
                </div>

                <div class="hp-bento animate-on-scroll">

                    <!-- Large featured card: Schemes (2-col span) -->
                    <a href="/schemes" class="hp-bento__card hp-bento__card--large hp-bento__card--green">
                        <div class="hp-bento__icon-wrap" style="background:#16a34a;">
                            <i class="fa-solid fa-file-lines" aria-hidden="true"></i>
                        </div>
                        <h3 class="hp-bento__title">सरकारी योजना</h3>
                        <p class="hp-bento__desc">केंद्र आणि राज्य सरकारच्या सर्व योजनांची सविस्तर माहिती मराठीत जाणून घ्या.</p>
                        <div class="hp-bento__tags">
                            <span>शेतकरी योजना</span><span>महिला कल्याण</span><span>शिक्षण शिष्यवृत्ती</span><span>आरोग्य विमा</span>
                        </div>
                        <span class="hp-bento__cta">योजना पहा <i class="fa-solid fa-arrow-right"></i></span>
                    </a>

                    <!-- Jobs -->
                    <a href="/jobs" class="hp-bento__card hp-bento__card--orange">
                        <div class="hp-bento__icon-wrap" style="background:#ea580c;">
                            <i class="fa-solid fa-briefcase" aria-hidden="true"></i>
                        </div>
                        <h3 class="hp-bento__title">रोजगार आणि करिअर</h3>
                        <p class="hp-bento__desc">सरकारी नोकरी, MPSC आणि भरती अपडेट्स.</p>
                    </a>

                    <!-- Services -->
                    <a href="/services" class="hp-bento__card hp-bento__card--indigo">
                        <div class="hp-bento__icon-wrap" style="background:#4f46e5;">
                            <i class="fa-solid fa-landmark" aria-hidden="true"></i>
                        </div>
                        <h3 class="hp-bento__title">सरकारी सेवा</h3>
                        <p class="hp-bento__desc">आधार, रेशन, दाखले – ऑनलाईन मदत.</p>
                    </a>

                    <!-- Training -->
                    <a href="/training" class="hp-bento__card hp-bento__card--amber">
                        <div class="hp-bento__icon-wrap" style="background:#d97706;">
                            <i class="fa-solid fa-graduation-cap" aria-hidden="true"></i>
                        </div>
                        <h3 class="hp-bento__title">प्रशिक्षण</h3>
                        <p class="hp-bento__desc">कौशल्य विकास व PMKVY योजना.</p>
                    </a>

                    <!-- Articles -->
                    <a href="/articles" class="hp-bento__card hp-bento__card--purple">
                        <div class="hp-bento__icon-wrap" style="background:#7c3aed;">
                            <i class="fa-solid fa-newspaper" aria-hidden="true"></i>
                        </div>
                        <h3 class="hp-bento__title">लेख</h3>
                        <p class="hp-bento__desc">माहितीपूर्ण विशेष लेख.</p>
                    </a>

                    <!-- Downloads -->
                    <a href="/downloads" class="hp-bento__card hp-bento__card--sky">
                        <div class="hp-bento__icon-wrap" style="background:#0284c7;">
                            <i class="fa-solid fa-download" aria-hidden="true"></i>
                        </div>
                        <h3 class="hp-bento__title">डाउनलोड्स</h3>
                        <p class="hp-bento__desc">सरकारी अर्ज नमुने PDF.</p>
                    </a>

                    <!-- Financial Literacy -->
                    <a href="/learn" class="hp-bento__card hp-bento__card--pink">
                        <div class="hp-bento__icon-wrap" style="background:#be185d;">
                            <i class="fa-solid fa-coins" aria-hidden="true"></i>
                        </div>
                        <h3 class="hp-bento__title">अर्थसाक्षरता</h3>
                        <p class="hp-bento__desc">बचत आणि गुंतवणूक मार्गदर्शन.</p>
                    </a>

                    <!-- Smart Tools -->
                    <a href="/tools" class="hp-bento__card hp-bento__card--teal">
                        <div class="hp-bento__icon-wrap" style="background:#0d9488;">
                            <i class="fa-solid fa-calculator" aria-hidden="true"></i>
                        </div>
                        <h3 class="hp-bento__title">स्मार्ट टूल्स</h3>
                        <p class="hp-bento__desc">उपयुक्त कॅल्क्युलेटर.</p>
                    </a>

                </div>
            </div>
        </section>

        <!-- Section 3: Category Grid – Modern Pill Cards -->
        <section id="popular-categories" class="scheme-category-section bg-alternating" aria-labelledby="popular-categories-title">
            <div class="container relative-container">
                <div class="section-header animate-on-scroll">
                    <h2 id="popular-categories-title">योजनांचे प्रकार (Browse by Category)</h2>
                    <p>तुमच्यासाठी योग्य योजना शोधा — श्रेणीनुसार</p>
                </div>
                <div class="category-grid animate-on-scroll">
                    <a href="/categories/farmer" class="category-chip">
                        <div class="category-chip__icon" style="background: linear-gradient(135deg, #22c55e, #16a34a);">
                            <i class="fa-solid fa-tractor"></i>
                        </div>
                        <span class="category-chip__label">शेतकरी</span>
                        <span class="category-chip__sub">Farmer</span>
                    </a>
                    <a href="/categories/women" class="category-chip">
                        <div class="category-chip__icon" style="background: linear-gradient(135deg, #ec4899, #db2777);">
                            <i class="fa-solid fa-person-dress"></i>
                        </div>
                        <span class="category-chip__label">महिला</span>
                        <span class="category-chip__sub">Women</span>
                    </a>
                    <a href="/categories/student" class="category-chip">
                        <div class="category-chip__icon" style="background: linear-gradient(135deg, #a855f7, #9333ea);">
                            <i class="fa-solid fa-graduation-cap"></i>
                        </div>
                        <span class="category-chip__label">विद्यार्थी</span>
                        <span class="category-chip__sub">Student</span>
                    </a>
                    <a href="/categories/business" class="category-chip">
                        <div class="category-chip__icon" style="background: linear-gradient(135deg, #f97316, #ea580c);">
                            <i class="fa-solid fa-briefcase"></i>
                        </div>
                        <span class="category-chip__label">व्यवसाय</span>
                        <span class="category-chip__sub">Business</span>
                    </a>
                    <a href="/categories/pension" class="category-chip">
                        <div class="category-chip__icon" style="background: linear-gradient(135deg, #64748b, #475569);">
                            <i class="fa-solid fa-piggy-bank"></i>
                        </div>
                        <span class="category-chip__label">पेन्शन</span>
                        <span class="category-chip__sub">Pension</span>
                    </a>
                    <a href="/categories/health" class="category-chip">
                        <div class="category-chip__icon" style="background: linear-gradient(135deg, #ef4444, #dc2626);">
                            <i class="fa-solid fa-heart-pulse"></i>
                        </div>
                        <span class="category-chip__label">आरोग्य</span>
                        <span class="category-chip__sub">Health</span>
                    </a>
                    <a href="/categories/insurance" class="category-chip">
                        <div class="category-chip__icon" style="background: linear-gradient(135deg, #3b82f6, #2563eb);">
                            <i class="fa-solid fa-shield-halved"></i>
                        </div>
                        <span class="category-chip__label">विमा</span>
                        <span class="category-chip__sub">Insurance</span>
                    </a>
                    <a href="/categories/worker" class="category-chip">
                        <div class="category-chip__icon" style="background: linear-gradient(135deg, #14b8a6, #0d9488);">
                            <i class="fa-solid fa-hard-hat"></i>
                        </div>
                        <span class="category-chip__label">कामगार</span>
                        <span class="category-chip__sub">Worker</span>
                    </a>
                    <a href="/categories/housing" class="category-chip">
                        <div class="category-chip__icon" style="background: linear-gradient(135deg, #f59e0b, #d97706);">
                            <i class="fa-solid fa-house-chimney"></i>
                        </div>
                        <span class="category-chip__label">गृहनिर्माण</span>
                        <span class="category-chip__sub">Housing</span>
                    </a>
                    <a href="/categories/social-security" class="category-chip">
                        <div class="category-chip__icon" style="background: linear-gradient(135deg, #6366f1, #4f46e5);">
                            <i class="fa-solid fa-hand-holding-heart"></i>
                        </div>
                        <span class="category-chip__label">सामाजिक सुरक्षा</span>
                        <span class="category-chip__sub">Social Security</span>
                    </a>
                    <a href="/categories/loans" class="category-chip">
                        <div class="category-chip__icon" style="background: linear-gradient(135deg, #10b981, #059669);">
                            <i class="fa-solid fa-coins"></i>
                        </div>
                        <span class="category-chip__label">कर्ज/वित्त</span>
                        <span class="category-chip__sub">Loans</span>
                    </a>
                    <a href="/categories/food" class="category-chip">
                        <div class="category-chip__icon" style="background: linear-gradient(135deg, #eab308, #ca8a04);">
                            <i class="fa-solid fa-wheat-awn"></i>
                        </div>
                        <span class="category-chip__label">अन्न सुरक्षा</span>
                        <span class="category-chip__sub">Food</span>
                    </a>
                    <a href="/categories/digital" class="category-chip">
                        <div class="category-chip__icon" style="background: linear-gradient(135deg, #06b6d4, #0891b2);">
                            <i class="fa-solid fa-laptop-code"></i>
                        </div>
                        <span class="category-chip__label">डिजिटल</span>
                        <span class="category-chip__sub">Digital</span>
                    </a>
                    <a href="/categories" class="category-chip category-chip--view-all">
                        <div class="category-chip__icon" style="background: transparent; border: 2px dashed var(--primary-light);">
                            <i class="fa-solid fa-arrow-right" style="color: var(--primary);"></i>
                        </div>
                        <span class="category-chip__label" style="color: var(--primary);">सर्व पहा</span>
                        <span class="category-chip__sub">View All</span>
                    </a>
                </div>
            </div>
        </section>

        <!-- Section 4: Smart Tools Strip -->
        <section id="smart-tools" class="container scheme-category-section" aria-labelledby="tools-title">
            <div class="section-header animate-on-scroll">
                <div class="section-badge" style="background: rgba(249, 115, 22, 0.1); color: #f97316; border-color: rgba(249, 115, 22, 0.2);">
                    <i class="fa-solid fa-wrench" aria-hidden="true"></i> Smart Tools
                </div>
                <h2 id="tools-title">स्मार्ट टूल्स (Smart Tools)</h2>
                <p>कॅल्क्युलेटर, चेकलिस्ट आणि इतर उपयुक्त साधने</p>
            </div>
            <div class="tools-strip animate-on-scroll">
                <a href="/tools/emi-calculator" class="tool-card">
                    <div class="tool-card__icon" style="background: linear-gradient(135deg, #3b82f6, #1d4ed8);">
                        <i class="fa-solid fa-calculator"></i>
                    </div>
                    <h3>EMI कॅल्क्युलेटर</h3>
                    <p>गृहकर्ज, वाहन कर्ज EMI तपासा</p>
                    <span class="tool-card__cta">वापरा <i class="fa-solid fa-arrow-right"></i></span>
                </a>
                <a href="/tools/eligibility-checker" class="tool-card">
                    <div class="tool-card__icon" style="background: linear-gradient(135deg, #22c55e, #16a34a);">
                        <i class="fa-solid fa-clipboard-check"></i>
                    </div>
                    <h3>पात्रता चेकर</h3>
                    <p>तुम्ही कोणत्या योजनेसाठी पात्र आहात?</p>
                    <span class="tool-card__cta">तपासा <i class="fa-solid fa-arrow-right"></i></span>
                </a>
                <a href="/tools/document-checklist" class="tool-card">
                    <div class="tool-card__icon" style="background: linear-gradient(135deg, #f97316, #ea580c);">
                        <i class="fa-solid fa-list-check"></i>
                    </div>
                    <h3>कागदपत्र चेकलिस्ट</h3>
                    <p>योजनेसाठी लागणारी कागदपत्रे</p>
                    <span class="tool-card__cta">पहा <i class="fa-solid fa-arrow-right"></i></span>
                </a>
                <a href="/tools/fd-rd-calculator" class="tool-card">
                    <div class="tool-card__icon" style="background: linear-gradient(135deg, #a855f7, #7c3aed);">
                        <i class="fa-solid fa-chart-line"></i>
                    </div>
                    <h3>FD/RD कॅल्क्युलेटर</h3>
                    <p>बचतीवर किती व्याज मिळेल?</p>
                    <span class="tool-card__cta">गणना करा <i class="fa-solid fa-arrow-right"></i></span>
                </a>
            </div>
            <div class="view-all-cta animate-on-scroll" style="margin-top: 1.5rem;">
                <a href="/tools" class="btn btn-secondary ripple-effect" style="gap: 0.5rem;">
                    <i class="fa-solid fa-wrench"></i> सर्व टूल्स पहा <i class="fa-solid fa-arrow-right arrow-icon"></i>
                </a>
            </div>
        </section>

        <!-- Section 5: Business & Employment Hub -->
        <section id="biz-jobs-hub" class="scheme-category-section bg-alternating" aria-labelledby="biz-hub-title">
            <div class="container">
                <div class="section-header animate-on-scroll">
                    <h2 id="biz-hub-title">व्यवसाय आणि रोजगार (Business & Jobs)</h2>
                    <p>उद्योजक आणि नोकरी शोधणाऱ्यांसाठी एकत्रित माहिती</p>
                </div>
                <div class="hub-split animate-on-scroll">
                    <div class="hub-card hub-card--biz">
                        <div class="hub-card__icon">
                            <i class="fa-solid fa-rocket"></i>
                        </div>
                        <h3>नवीन व्यवसाय सुरू करत आहात?</h3>
                        <ul>
                            <li><i class="fa-solid fa-check-circle"></i> व्यवसाय कसा सुरू करावा</li>
                            <li><i class="fa-solid fa-check-circle"></i> लागणारे परवाने व नोंदणी</li>
                            <li><i class="fa-solid fa-check-circle"></i> सरकारी कर्ज योजना (MUDRA, PMEGP)</li>
                            <li><i class="fa-solid fa-check-circle"></i> PM विश्वकर्मा योजना</li>
                        </ul>
                        <a href="/business" class="btn btn-primary ripple-effect" style="margin-top: auto;">
                            <i class="fa-solid fa-book-open"></i> व्यवसाय गाईड वाचा
                        </a>
                    </div>
                    <div class="hub-card hub-card--jobs">
                        <div class="hub-card__icon">
                            <i class="fa-solid fa-user-tie"></i>
                        </div>
                        <h3>नोकरी / रोजगार मार्गदर्शन</h3>
                        <ul>
