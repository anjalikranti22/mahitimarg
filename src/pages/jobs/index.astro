---
import Layout from '../../layouts/Layout.astro';

export const jobsData = [
  {
    id: "govt-jobs",
    title: "सरकारी भरती (Govt Jobs)",
    description: "MPSC, जिल्हा परिषद, आणि पोलीस भरतीचे नवीन अपडेट्स.",
    icon: "fa-solid fa-building-columns", // Mapped from 'briefcase'
    link: "/jobs/government",
    featured: true
  },
  {
    id: "skill-india",
    title: "कौशल्य विकास प्रशिक्षण",
    description: "PMKVY आणि इतर मोफत सरकारी प्रशिक्षण योजना.",
    icon: "fa-solid fa-graduation-cap", // Mapped from 'academic-cap'
    link: "/jobs/skills",
    featured: false
  },
  {
    id: "resume-guide",
    title: "रेझ्युमे कसा बनवावा?",
    description: "प्रभावी रेझ्युमे बनवण्याच्या टिप्स आणि मोफत टेम्पलेट्स.",
    icon: "fa-solid fa-file-contract", // Mapped from 'document-text'
    link: "/jobs/resume-guide",
    featured: false
  },
  {
    id: "freelance",
    title: "फ्रीलान्सिंग मार्गदर्शन",
    description: "घरी बसून ऑनलाईन पैसे कसे कमवावे याची माहिती.",
    icon: "fa-solid fa-globe", // Mapped from 'globe-alt'
    link: "/jobs/freelance",
    featured: false
  }
];

const jobsBreadcrumbs = [
  { name: 'मुख्यपृष्ठ', url: 'https://mahitimarg.in/' },
  { name: 'नोकरी आणि रोजगार', url: 'https://mahitimarg.in/jobs/' },
];

const jobsKeywords = 'सरकारी नोकरी महाराष्ट्र, MPSC भरती 2025, government jobs Maharashtra, जिल्हा परिषद भरती, पोलीस भरती, PMKVY training, रोजगार संधी, नोकरी कुठे मिळेल, online jobs Marathi, mahitimarg jobs';
---

<Layout
  title="नोकरी आणि रोजगार (Jobs & Employment) | MahitiMarg"
  description="महाराष्ट्रातील सरकारी भरती, MPSC, जिल्हा परिषद, पोलीस भरती आणि रोजगाराच्या सर्व संधी एकाच ठिकाणी."
  keywords={jobsKeywords}
  canonical="https://mahitimarg.in/jobs/"
  breadcrumbs={jobsBreadcrumbs}
>
    <main>
        <!-- Hero Section -->
        <section class="hero" aria-labelledby="jobs-hero-title">
            <div class="hero-bg-accent"></div>
            <div class="container glass-panel hero-glass animate-on-load" style="padding: 3rem 2rem; text-align: center;">
                <div style="font-size: 3rem; color: var(--primary); margin-bottom: 1rem;">
                    <i class="fa-solid fa-briefcase"></i>
                </div>
                <h1 id="jobs-hero-title" class="title-gradient">नोकरी आणि रोजगार (Jobs & Employment)</h1>
                <p class="hero-description" style="max-width: 700px; margin: 0 auto;">
                    महानगरपालिका, म्हाडा, पोलीस भरती आणि सर्व खाजगी नोकरीच्या संधी आता एकाच ठिकाणी...
                </p>
            </div>
        </section>

        <!-- Bento-Box Category Grid (GSAP Master Standards) -->
        <section class="container scheme-category-section" style="padding-top: 2rem; padding-bottom: 4rem;">
            <div class="section-header animate-on-scroll">
                <h2>रोजगार श्रेणी (Employment Categories)</h2>
                <p>खालीलपैकी तुमचा आवडीचा विभाग निवडा</p>
            </div>
            
            <div class="schemes-grid animate-on-scroll" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;">
                {jobsData.map((job) => (
                    <a href={job.link} class="glass-panel" style={`
                        display: flex; 
                        flex-direction: column; 
                        padding: 2.5rem 2rem; 
                        text-decoration: none; 
                        border: 1px solid rgba(255,255,255,0.2); 
                        border-radius: 16px; 
                        background: rgba(255, 255, 255, 0.85);
                        backdrop-filter: blur(12px);
                        transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.3s ease;
                        position: relative;
                        overflow: hidden;
                        ${job.featured ? 'border-top: 4px solid var(--primary-color); box-shadow: 0 4px 15px -3px rgba(34, 197, 94, 0.1);' : 'border-top: 4px solid var(--accent);'}
                    `}
                    onmouseenter="this.style.transform='scale(1.03)'; this.style.boxShadow='0 15px 30px -5px rgba(0, 0, 0, 0.1)'"
                    onmouseleave="this.style.transform='scale(1)'; this.style.boxShadow=job.featured ? '0 4px 15px -3px rgba(34, 197, 94, 0.1)' : 'none'"
                    >
                        {job.featured && (
                            <div style="position: absolute; top: 1rem; right: 1rem; background: var(--primary-color); color: white; padding: 0.3rem 0.8rem; border-radius: 999px; font-size: 0.75rem; font-weight: bold; display: flex; align-items: center; gap: 0.4rem; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">
                                <i class="fa-solid fa-fire"></i> Trending
                            </div>
                        )}
                        <div style="font-size: 2.5rem; color: var(--primary); margin-bottom: 1.5rem;">
                            <i class={job.icon}></i>
                        </div>
                        <h3 style="font-size: 1.4rem; font-weight: 700; color: var(--text-dark); margin-bottom: 0.75rem; font-family: 'Mukta', sans-serif;">
                            {job.title}
                        </h3>
                        <p style="color: var(--text-main); font-size: 1.05rem; line-height: 1.6; margin-bottom: 1.5rem; flex-grow: 1;">
                            {job.description}
                        </p>
                        <div style="color: var(--primary-color); font-weight: 600; display: flex; align-items: center; gap: 0.5rem; margin-top: auto; font-size: 0.95rem;">
                            सविस्तर माहिती <i class="fa-solid fa-arrow-right"></i>
                        </div>
                    </a>
                ))}
            </div>
            
            <div class="view-all-cta animate-on-scroll" style="margin-top: 2rem;">
                <p style="color: var(--text-muted); font-size: 0.95rem;"><i class="fa-solid fa-circle-info margin-right-0-5"></i> ही माहिती नियमितपणे अपडेट केली जाते. नवीन नोकरीच्या संधींसाठी पुन्हा भेट द्या.</p>
            </div>
        </section>
    </main>
</Layout>
